local function standPositionFromInfo(info)
    if type(info) ~= "table" then
        return nil
    end
    local keys = {
        "Position", "CFrame", "StandPosition", "StandCFrame",
        "Pos", "Location", "Spawn", "SpawnPosition", "TrainingPosition",
    }
    for _, key in ipairs(keys) do
        local value = info[key]
        if typeof(value) == "Vector3" then
            return CFrame.new(value)
        elseif typeof(value) == "CFrame" then
            return value
        end
    end
    return nil
end

local function findStandCFrame()
    
    if okData and okStands then
        local okTier, tierValue = pcall(function()
            return tonumber(DataController:Get("Stand")) or 0
        end)
        local tier = okTier and tierValue or 0
        local okInfo, info = pcall(function()
            return StandsConfig.Get(tier)
        end)
        if okInfo then
            local cf = standPositionFromInfo(info)
            if cf then
                return cf
            end
        end
    end

    local patterns = {
        "stand", "barra", "bar", "training", "train",
        "bench", "press", "maquina", "gym", "spot", "spawn",
    }
    local best, bestScore = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = string.lower(obj.Name)
        local matched = false
        for _, pattern in ipairs(patterns) do
            if string.find(name, pattern, 1, true) then
                matched = true
                break
            end
        end
        if matched and (obj:IsA("Model") or obj:IsA("BasePart")) then
            local cf = nil
            if obj:IsA("Model") and obj.GetModelCFrame then
                local okCf, result = pcall(function() return obj:GetModelCFrame() end)
                if okCf then cf = result end
            else
                local okCf, result = pcall(function() return obj.CFrame end)
                if okCf then cf = result end
            end
            if cf then
                local pos = cf.Position
                if pos.Y > -50 and pos.Y < 500 then
                    local score = (pos - STAND_HOME.Position).Magnitude
                    if obj:IsA("Model") then
                        score = score - 1
                    end
                    if score < bestScore then
                        best, bestScore = cf, score
                    end
                end
            end
        end
    end

    if best then
      
        return best + Vector3.new(0, 2.5, 0)
    end

    return STAND_HOME
end

