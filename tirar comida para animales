end

local webhookQueue = {}
local webhookBusy = false
local function drainWebhookQueue()
    if webhookBusy then
        return
    end
    webhookBusy = true
    task.spawn(function()
        while STATE.alive() and #webhookQueue > 0 do
            local content = table.remove(webhookQueue, 1)
            local url = R.webhookUrl
            local req = request or (type(http_request) == "function" and http_request or nil)
            if type(url) == "string" and url ~= "" and req then
                for attempt = 1, 4 do
                    local ok, resp = pcall(function()
                        return req({
                            Url = url,
                            Method = "POST",
                            Headers = { ["Content-Type"] = "application/json" },
                            Body = HttpService:JSONEncode({ content = content }),
                        })
                    end)
                    local status = 0
                    if type(resp) == "table" then
                        status = tonumber(resp.StatusCode or resp.status or resp.Status) or 0
                    end
                    if ok and (status == 0 or (status >= 200 and status < 300)) then
                        break
                    end
                    task.wait(0.5 * attempt)
                end
            end
            task.wait(0.1)
        end
        webhookBusy = false
    end)
end

local function postWebhook(content)
    webhookQueue[#webhookQueue + 1] = content
    drainWebhookQueue()
end

local function sendResultWebhook(res)
    if not R.webhookOn then
        return
    end
    local lines = {}
    if R.discordKg then
        lines[#lines + 1] = "kg ; " .. kgText(res)
    end
    if R.discordPerSec then
        local okNF, NF = pcall(function()
            return require(RS:WaitForChild("Shared"):WaitForChild("NumberFormat"))
        end)
        local per = okNF and NF.PerSecond(tonumber(res.Income) or 0) or tostring(res.Income)
        lines[#lines + 1] = "$/s ; " .. tostring(per)
    end
    if R.discordZone then
        lines[#lines + 1] = "Zone ; " .. tostring(res.AreaName or res.AreaKey)
    end
    if R.discordLuck then
        local luck = luckText(res)
        if not luck or luck == "" then
            luck = "1 en X"
        end
        lines[#lines + 1] = "Luck ; " .. luck
    end
    if R.discordMutation then
        lines[#lines + 1] = "Mutacion ; " .. mutationText(res)
    end
    if R.discordName then
        lines[#lines + 1] = "Nombre ; " .. animalNameText(res)
    end
    if #lines == 0 then
        return
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "@everyone"
    postWebhook(table.concat(lines, "\n"))
end

