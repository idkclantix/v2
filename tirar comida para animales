local STATE = STATE
if type(STATE) ~= "table" then
    local cleanups = {}
    local connections = {}
    STATE = {}

    function STATE.alive()
        return true
    end

    function STATE.onCleanup(fn)
        cleanups[#cleanups + 1] = fn
    end

    function STATE.connect(signal, fn)
        local ok, conn = pcall(function()
            return signal:Connect(fn)
        end)
        if ok and conn then
            connections[#connections + 1] = conn
        end
        return conn
    end

    function STATE.override(tbl, key, value)
        pcall(function()
            tbl[key] = value
        end)
    end

    function STATE.namecallHook(method, fn)
        if not genv.__real_namecall_hooks then
            genv.__real_namecall_hooks = {}
        end
        local hooks = genv.__real_namecall_hooks
        hooks[method] = hooks[method] or {}
        hooks[method][TOKEN] = fn

        if not genv.__real_namecall_installed then
            genv.__real_namecall_installed = true
            local old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local name = getnamecallmethod()
                local list = name and genv.__real_namecall_hooks and genv.__real_namecall_hooks[name]
                if list then
                    for _, cb in pairs(list) do
                        pcall(cb, self, name, ...)
                    end
                end
                return old(self, ...)
            end, "RealAutofarmNamecall"))
            genv.__real_namecall_old = old
        end
    end

    local finalCleanup
    finalCleanup = function()
        for _, conn in ipairs(connections) do
            pcall(function() conn:Disconnect() end)
        end
        local hooks = genv.__real_namecall_hooks
        if hooks then
            for _, list in pairs(hooks) do
                list[TOKEN] = nil
            end
        end
        for i = #cleanups, 1, -1 do
            if cleanups[i] ~= finalCleanup then
                pcall(cleanups[i])
            end
        end
    end
    cleanups[#cleanups + 1] = finalCleanup
end

