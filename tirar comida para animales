local function luckText(res)
    local LC = loadModule("Shared.LuckyCatch")
    local odds

    if type(res.Lucky) == "table" then
        local l = res.Lucky
        odds = tonumber(l.OneIn) or tonumber(l.OneInOdds) or tonumber(l.Odds)
        if not odds and l.Chance then
            odds = LC and tonumber(LC.GetOneInOdds(tonumber(l.Chance) or 0)) or nil
        end
        if not odds and l.Tier and LC and LC.GetTierOneInOdds then
            odds = tonumber(LC.GetTierOneInOdds(l.Tier))
        end
    end

    odds = odds or tonumber(res.OneIn) or tonumber(res.LuckyOneIn)
    if not odds and tonumber(res.Chance) and LC then
        odds = tonumber(LC.GetOneInOdds(tonumber(res.Chance)))
    end
    if not odds then
        local GC = loadModule("Config.GameConfig")
        if GC and type(GC.LuckyCatch) == "table" and LC then
            odds = tonumber(LC.GetOneInOdds(tonumber(GC.LuckyCatch.MaxChance) or 0))
        end
    end

    if odds and odds > 0 then
        return "1 en " .. tostring(math.floor(odds + 0.5))
    end
    return "1 en X"
end

local function kgText(res)
    local name = res.ModelName or res.DisplayName
    local size = tonumber(res.Size) or 1
