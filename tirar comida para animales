local armSandwich

local function throwOnce(mode, epoch)
    
    pcall(function()
        local chr = LocalPlayer.Character
        local root = chr and chr:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = FARM_HOME
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
    local readyLeft = 0
    pcall(function()
        readyLeft = (LocalPlayer:GetAttribute("ThrowReadyAt") or 0) - workspace:GetServerTimeNow()
    end)
    if readyLeft > 0 then
        task.wait(math.min(readyLeft + 0.2, 3))
    end
    invAsync("Throw_Cancel", "Reset")
    task.wait(0.35)
    local started
    for attempt = 1, 3 do
        started = inv("Throw_Start")
        if started.Ok or stopped(epoch) then
            break
        end
        invAsync("Throw_Cancel", "Reset")
        task.wait(0.9)
    end
    if not started.Ok then
        if tostring(started.Reason) == "Busy" then
            invAsync("Throw_Cancel", "Reset")
        end
        notifyError(tostring(started.Reason))
        return false
    end
    if stopped(epoch) then
        invAsync("Throw_Cancel", "Reset")
        return false
    end

    task.wait(REMOTE_WAIT)

    armSandwich()

    local pos = 1

    if mode == "normal" then
        if R.superThrow then
            inv("Throw_UseSuper")
            task.wait(REMOTE_WAIT)
            if stopped(epoch) then
                invAsync("Throw_Cancel", "Reset")
                return false
            end
        end
        fire("Throw_MeterStarted")
        task.wait(REMOTE_WAIT)
        if stopped(epoch) then
            invAsync("Throw_Cancel", "Reset")
            return false
        end
    end

    local res = inv("Throw_Resolve", pos)
    if not res.Ok then
        notifyError("resolve: " .. tostring(res.Reason))
        return false
    end
    if stopped(epoch) then
        invAsync("Throw_Cancel", "Reset")
        return false
    end

    task.wait(REMOTE_WAIT)

    if mode == "normal" then
        fire("Throw_Revealed")
        task.wait(REMOTE_WAIT)
        if stopped(epoch) then
            invAsync("Throw_Cancel", "Reset")
            return false
        end
    end

    local done = inv("Throw_Complete")
    if not done.Ok then
        notifyError("complete: " .. tostring(done.Reason))
        return false
    end

    invAsync("Throw_Cancel", "Reset")

    R.throws = R.throws + 1
    notifyResult(res)
    return true
end

