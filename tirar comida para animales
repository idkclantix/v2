STATE.onCleanup(function()
    R.epoch = R.epoch + 1
    R.trainEpoch = R.trainEpoch + 1
    stopMovement()
    R.normal = false
    R.fast = false
    R.equipBest = false
    R.autoBuyFood = false
    R.autoFence = false
    R.autoTrain = false
    R.autoTap = false
    R.autoUpgrade = false
    pcall(stopTraining)
    pcall(function() Window:Destroy() end)
end)

task.spawn(function()
    while STATE.alive() and R.instanceToken == TOKEN do
        if not (R.normal or R.fast) then
            task.wait(0.15)
        else
            
            while R.enteringFarm and STATE.alive() and R.instanceToken == TOKEN do
                task.wait(0.1)
            end
            local epoch = R.epoch
            local mode = R.normal and "normal" or "fast"
            if stopped(epoch) then
                continue
            end
            if mode == "normal" then
                throwNative(epoch)
            else
                throwOnce(mode, epoch)
            end
            if stopped(epoch) then
                continue
            end
            
            enterFarm()
            task.wait(mode == "normal" and LOOP_NORMAL or LOOP_FAST)
        end
    end
end)

