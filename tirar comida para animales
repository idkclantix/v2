local function inv(name, ...)
    local args = { ... }
    local r = F:WaitForChild(name)
    local ok, res = pcall(function()
        return r:InvokeServer(table.unpack(args))
    end)
    if not ok then
        return { Ok = false, Reason = tostring(res) }
    end
    if type(res) ~= "table" then
        return { Ok = false, Reason = "respuesta invalida" }
    end
    return res
end

local function fire(name)
    pcall(function()
