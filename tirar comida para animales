task.spawn(function()
    while STATE.alive() and R.instanceToken == TOKEN do
        if R.autoFence then
            local money = tonumber(DataController:Get("Money")) or 0
            local now = os.clock()
            if now >= (R.fenceRetryAt or 0)
                and (R.fenceLastMoney == nil or money ~= R.fenceLastMoney) then
                R.fenceLastMoney = money
                local ok, res = pcall(function()
                    local Event = game:GetService("ReplicatedStorage").Remotes.Plot_UpgradeFence
                    return Event:InvokeServer()
                end)
                if ok and type(res) == "table" and res.Ok then
                    R.fenceRetryAt = now + 2
                    R.fenceLastMoney = nil
                elseif ok and type(res) == "table" and tostring(res.Reason) == "Money" then
                    R.fenceRetryAt = now + 8
                else
                    R.fenceRetryAt = now + 4
                end
            end
        end
        task.wait(2)
    end
end)

task.spawn(function()
    while STATE.alive() and R.instanceToken == TOKEN do
        if not R.autoTrain then
            task.wait(0.2)
        else
            local epoch = R.trainEpoch
            if trainRunning() then
                task.wait(0.4)
            else
                if os.clock() < R.trainRetryAt then
                    task.wait(0.2)
                    continue
                end
                teleportStand()
                task.wait(0.5)
                if not R.autoTrain or R.trainEpoch ~= epoch then
                    continue
                end
                task.spawn(function()
                    if epoch ~= R.trainEpoch or not R.autoTrain then
                        return
                    end
                    pcall(function()
                        TrainingController.Start()
                    end)
                end)
                task.wait(0.6)
                if not trainRunning() then
                    R.trainRetryAt = os.clock() + 1.8
                end
            end
        end
    end
end)

