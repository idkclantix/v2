local function trainRunning()
    if not okTrain then
        return false
    end
    local ok, res = pcall(function()
        return TrainingController.IsRunning()
    end)
    return ok and res == true
end

local function stopTraining()
    pcall(function()
        if okTrain then
            TrainingController.Stop()
        end
    end)
    inv("Training_Stop")
end

local SANDWICH_TYPES = { "Mega", "Big", "Regular" }
armSandwich = function()
    if not R.autoSandwich or R.superThrow then
        return
    end
    if not okData then
        return
    end
    local th = DataController:Get("Thanksgiving")
    if type(th) ~= "table" or type(th.Sandwiches) ~= "table" then
        return
    end
    for _, name in ipairs(SANDWICH_TYPES) do
        if (tonumber(th.Sandwiches[name]) or 0) > 0 then
            inv("Throw_UseSandwich", name)
            return
        end
    end
end

local function throwNative(epoch)
    if not okThrow then
        return false
    end

    local seq0 = R.nativeSeq
    if R.nativeSeq > seq0 and type(R.nativeResult) == "table" and R.nativeResult.Ok then
        R.throws = R.throws + 1
        notifyResult(R.nativeResult)
        return true
    end

    local waitAuto = os.clock() + 0.6
    while R.nativeSeq == seq0 and os.clock() < waitAuto and STATE.alive()
        and R.instanceToken == TOKEN and R.epoch == epoch do
        task.wait(0.1)
    end
    if R.nativeSeq > seq0 and type(R.nativeResult) == "table" and R.nativeResult.Ok then
        R.throws = R.throws + 1
        notifyResult(R.nativeResult)
        return true
    end
    if stopped(epoch) then
        return false
    end

    local busy = false
    if okClientState then
        pcall(function() busy = ClientState.Busy == "Throw" end)
    end

    if not busy then
    
        if okMove then
            pcall(function() Movement.Unlock() end)
        end
        pcall(function()
            local chr = LocalPlayer.Character
            local root = chr and chr:FindFirstChild("HumanoidRootPart")
            if root then
                root.CFrame = FARM_HOME
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end)
        local readyLeft = 0
        pcall(function()
            readyLeft = (LocalPlayer:GetAttribute("ThrowReadyAt") or 0) - workspace:GetServerTimeNow()
        end)
        if readyLeft > 0 then
            task.wait(math.min(readyLeft + 0.2, 3))
        end

        if okMeter then
            pcall(function()
                ThrowMeter.TestAutoTap = 0.12
            end)
        end

        if R.superThrow then
            inv("Throw_UseSuper")
        end

        task.spawn(function()
            pcall(function()
                ThrowController.Start()
            end)
        end)

        task.spawn(function()
            task.wait(0.4)
            if R.epoch == epoch then
                armSandwich()
            end
        end)
    end

    local deadline = os.clock() + 3
    while R.nativeSeq == seq0 and STATE.alive() and R.instanceToken == TOKEN and R.epoch == epoch and os.clock() < deadline do
        task.wait(0.1)
    end

    if R.nativeSeq > seq0 and type(R.nativeResult) == "table" and R.nativeResult.Ok then
        R.throws = R.throws + 1
        notifyResult(R.nativeResult)
        return true
    end

    invAsync("Throw_Cancel", "Reset")
    task.wait(0.2)
    if stopped(epoch) then
        return false
    end
    return throwOnce("normal", epoch)
end

