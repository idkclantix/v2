local function buyBestFood()
    if not (okFoods and okCurve and okData) then
        notifyError("No se pudo leer la configuracion de comida.")
        return
    end

    local bestOwned = 0
    for i = 1, FoodsConfig.Count() do
        if DataController:GetPath("OwnedFoods." .. i) == true then
            bestOwned = i
        end
    end

    local money = tonumber(DataController:Get("Money")) or 0
    for i = FoodsConfig.CountAll(), bestOwned + 1, -1 do
        local food = FoodsConfig.GetAny(i)
        if food then
            local price = BalanceCurve.GetItemPrice(LocalPlayer, food)
            if price and price > 0 and price <= money then
                local res = inv("Shop_Buy", i)
                if res.Ok then
                    
                    inv("Shop_Equip", i)
                    return
                end
            end
        end
    end
end

