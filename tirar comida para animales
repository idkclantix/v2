task.spawn(function()
    while STATE.alive() and R.instanceToken == TOKEN do
        if R.autoUpgrade then
            local money = tonumber(DataController:Get("Money")) or 0
            local price = nextStandPrice()
            local enough = price and price > 0 and price <= money
            local unblocked = money > (R.standBlockedAt or 0)
            if enough and unblocked then
                local res = inv("Stand_Upgrade")
                local reason = tostring(res.Reason)
                if res.Ok then
                    R.standBlockedAt = 0
                elseif reason == "TooFar" then
                    teleportStand()
                    local res2 = inv("Stand_Upgrade")
                    if not res2.Ok and tostring(res2.Reason) == "Money" then
                        R.standBlockedAt = money
                    end
                elseif reason == "Money" then
                    R.standBlockedAt = money
                end
            end
        end
        task.wait(2)
    end
end)

