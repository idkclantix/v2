local function stopMovement()
    R.moveToken = (R.moveToken or 0) + 1
    pcall(function()
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if hum and root then
            hum:MoveTo(root.Position)
        end
    end)
end

local function moveTo(cf, speed)
    pcall(function()
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            return
        end

        if okMove then
            pcall(function()
                if Movement.IsLocked() then
                    Movement.Unlock()
                end
            end)
        end

        local target = typeof(cf) == "CFrame" and cf.Position or cf
        local dist = (target - hrp.Position).Magnitude
        if dist < 0.5 then
            return
        end

        local oldSpeed = hum.WalkSpeed
        hum.WalkSpeed = speed or WALK_SPEED
        pcall(function()
            hum:MoveTo(target)
        end)

        local deadline = os.clock() + math.max(3, dist / (speed or WALK_SPEED) + 4)
        local lastPos = hrp.Position
        local stuckAt = os.clock()
        local lastIssue = os.clock()
        local token = R.moveToken
        local aborted = false
        while STATE.alive() and os.clock() < deadline do
            if R.moveToken ~= token then
                aborted = true
                break
            end
            local root = ch:FindFirstChild("HumanoidRootPart")
            if not root then
                break
            end
            local moving = hum.MoveDirection.Magnitude > 0.05
            if moving then
                lastIssue = os.clock()
            elseif os.clock() - lastIssue >= 0.4 then
                hum.WalkSpeed = speed or WALK_SPEED
                pcall(function() hum:MoveTo(target) end)
                lastIssue = os.clock()
            end
            local remaining = (target - root.Position).Magnitude
            if remaining < 2.5 then
                break
            end
            if (lastPos - root.Position).Magnitude > 0.2 then
                lastPos = root.Position
                stuckAt = os.clock()
            elseif os.clock() - stuckAt > 2 then
                break 
            end
            task.wait(0.1)
        end
        pcall(function()
            local root = hum.RootPart
            if root then
                hum:MoveTo(root.Position)
            end
        end)
        hum.WalkSpeed = oldSpeed
        if not STATE.alive() then
            aborted = true
        end
        if aborted then
            return
        end

        pcall(function()
            local root = ch:FindFirstChild("HumanoidRootPart")
            if root and (target - root.Position).Magnitude > 1.5 then
                root.CFrame = typeof(cf) == "CFrame" and cf or CFrame.new(target)
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end)
    end)
end

