local sentByRef = setmetatable({}, { __mode = "k" })
local lastSentKey, lastSentAt = nil, 0
local function notifyResult(res)
    if type(res) ~= "table" or sentByRef[res] then
        return
    end
    sentByRef[res] = true

    local key = table.concat({
        tostring(res.Throws), tostring(res.DisplayName), tostring(res.ModelName),
        tostring(res.Income), tostring(res.AreaIndex), tostring(res.Size),
        tostring(res.Mutation), tostring(res.Highlight),
    }, "|")
    local now = os.clock()
    if key == lastSentKey and now - lastSentAt < 1.5 then
        return
    end
    lastSentKey, lastSentAt = key, now

    local area = tonumber(res.AreaIndex) or 0
    if area > R.maxArea then
        R.maxArea = area
    end
    sendResultWebhook(res)
end

