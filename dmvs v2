local function waitToolEquipped(tool, humanoid, timeout)
    local start = os.clock()
    while os.clock() - start < timeout do
        local char = player.Character
        if not char or not humanoid.Parent then return false end
        if tool.Parent == char then return true end
        task.wait()
    end
    return false
end

