local function modConfirmLocalKill(body, deathCF)
    if destroyed then return end
    local nowAll = os.clock()
    local target = typeof(body) == "Instance" and body or nil
    -- Un mismo kill dispara varias fuentes (remote/tag, Died, leaderstats, atributos).
    -- Las señales de stats son las que llegan tarde y hacian sonar el sonido dos veces.
    local cooldown = MOD_KILL_GLOBAL_COOLDOWN
    if not target then
        cooldown = modLastKillHadTarget and MOD_KILL_STAT_ECHO_COOLDOWN or MOD_KILL_STAT_COOLDOWN
    end
    if nowAll - modLastAnyKill < cooldown then return end
    modLastAnyKill = nowAll
    modLastKillHadTarget = target ~= nil
    if target and modKillDedupe[target] then return end
    if target then
        modKillDedupe[target] = true
        task.delay(MOD_KILL_TARGET_DEDUPE_TIME, function() modKillDedupe[target] = nil end)
    else
        local now = os.clock()
        if now - modLastStatKill < MOD_KILL_STAT_COOLDOWN then return end
        modLastStatKill = now
    end
    local cf = deathCF
    if not cf and target then
        local root = target:FindFirstChild("HumanoidRootPart")
        cf = root and root.CFrame or nil
    end
    if modKillSound.Enabled then modPlayKillSound() end
    if modKillFX.Enabled and target then modSpawnKillFX(target, cf) end
end

