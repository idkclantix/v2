local teamState = { Snapshot = {}, LastRefresh = 0, RefreshInterval = 0.12 }

local function refreshScoreboardTeams(force)
    local now = os.clock()
    if not force and now - teamState.LastRefresh < teamState.RefreshInterval then
        return teamState.Snapshot
    end
    teamState.LastRefresh = now
    local snapshot = {}
    local pg = player:FindFirstChild("PlayerGui")
    local score = pg and pg:FindFirstChild("IngameScore", true)
    if score then
        local red = score:FindFirstChild("TeamRed")
        local blue = score:FindFirstChild("TeamBlue")
        if red then for _, e in ipairs(red:GetChildren()) do snapshot[string.lower(e.Name)] = "Red" end end
        if blue then for _, e in ipairs(blue:GetChildren()) do snapshot[string.lower(e.Name)] = "Blue" end end
    end
    teamState.Snapshot = snapshot
    return snapshot
end

local function resolvePlayerTeam(plr)
    if not plr then return nil end
    local snap = refreshScoreboardTeams(false)
    local byName = snap[string.lower(plr.Name)]
    if not byName and plr.DisplayName then byName = snap[string.lower(plr.DisplayName)] end
    if byName then return byName end
    local attr = plr:GetAttribute("Team") or plr:GetAttribute("team")
    if attr and tostring(attr) ~= "" then return tostring(attr) end
    if plr.Team then return plr.Team.Name end
    return nil
end

local function isEnemy(target)
    if not target or target == player then return false end
    local myMatch = player:GetAttribute("MatchId")
    local theirMatch = target:GetAttribute("MatchId")
    if myMatch and theirMatch and myMatch ~= "" and theirMatch ~= "" and myMatch ~= theirMatch then return false end
    local a, b = resolvePlayerTeam(player), resolvePlayerTeam(target)
    if a and b then return a ~= b end
    return true
end

local function isAlly(target)
    if not target or target == player then return false end
    local myMatch = player:GetAttribute("MatchId")
    local theirMatch = target:GetAttribute("MatchId")
    if myMatch and theirMatch and myMatch ~= "" and theirMatch ~= "" and myMatch ~= theirMatch then return false end
    local a, b = resolvePlayerTeam(player), resolvePlayerTeam(target)
    if a and b then return a == b end
    return false
end

-- ✅ FIX 4: helper — is a player in OUR match (ally or enemy, not a foreign match)
local function isInMyMatch(targetPlayer)
    if not targetPlayer then return false end
    local myMatch = player:GetAttribute("MatchId")
    local theirMatch = targetPlayer:GetAttribute("MatchId")
    -- if neither has a MatchId attribute fall back to same-team/enemy logic (same session)
    if not myMatch or myMatch == "" or not theirMatch or theirMatch == "" then
        return true -- no match system in this game, treat everyone as same match
    end
    return myMatch == theirMatch
end

local function isKnife(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = string.lower(tool.Name)
    return name == "1"
        or name:find("knife", 1, true) ~= nil
        or name:find("cuchillo", 1, true) ~= nil
        or name:find("dagger", 1, true) ~= nil
        or tool:FindFirstChild("Slash") ~= nil
        or tool:FindFirstChild("SlashStart") ~= nil
end

local function isGun(tool)
    if not tool or not tool:IsA("Tool") or isKnife(tool) then return false end
    if tool:FindFirstChild("Throw", true) or tool:FindFirstChild("KnifeClient", true) or tool:FindFirstChild("KnifeServer", true) then
        return false
    end
    local name = string.lower(tool.Name)
    for _, word in ipairs({"combat","fist","wallet","phone","punch","boombox","radio","blade","kunai","sword","toy","juguete","pizza","burger","teddy","balloon","drink","food"}) do
        if name:find(word, 1, true) then return false end
    end
    local showBeam = tool:FindFirstChild("showBeam")
    if showBeam and showBeam:IsA("RemoteEvent") then return true end
    return true
end

