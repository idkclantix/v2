local macroEnabled = false; local macroBusy = false; local touchHeld = false
local macroTouch = { MinXFraction = 0.45, DragPx = 10, Active = {}, StartPos = {}, WasDrag = {} }

local function isInMatch()
    local gui = player:FindFirstChild("PlayerGui"); if not gui then return false end
    local main = gui:FindFirstChild("Main") or gui; local gameFrame = main:FindFirstChild("MainGameFrame")
    if not gameFrame or not gameFrame.Visible then return false end
    local score = gameFrame:FindFirstChild("IngameScore"); local timer = score and score:FindFirstChild("Timer")
    if not timer then return false end
    local value = tostring(timer.Text or ""):gsub("%s","")
    if value == "" or value:find("-",1,true) or value == "0:00" or value == "00:00" then return false end
    return value:match("^%d+:%d%d$") ~= nil
end

local function isLobbyMacro()
    local character = player.Character; if not character then return true end
    if character:FindFirstChildOfClass("ForceField") then return true end
    local team = player.Team
    if team then
        local name = string.lower(team.Name)
        for _, word in ipairs({"lobby","spectat","espectador","menu","dead"}) do if name:find(word,1,true) then return true end end
    end
    return not isInMatch()
end

local function knifeEquipped()
    local character = player.Character; local tool = character and character:FindFirstChildOfClass("Tool")
    return isKnife(tool)
end

local function runMacro()
    if not macroEnabled or macroBusy or autoEquip.Busy or isLobbyMacro() or knifeEquipped() then return end
    macroBusy = true
    local character = player.Character; local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid or humanoid.Health <= 0 then macroBusy = false; return end
    if isLobbyMacro() or knifeEquipped() then macroBusy = false; return end
    local gun = getGun()
    if gun then
        if gun.Parent ~= character then pcall(function() humanoid:EquipTool(gun) end); task.wait(0.04) end
        if macroEnabled and not isLobbyMacro() and not knifeEquipped() and gun.Parent == character then
            pcall(function() gun:Activate() end); task.wait(0.08)
            pcall(function() if gun.Parent == player.Character then humanoid:UnequipTools() end end)
        end
    end
    macroBusy = false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not macroEnabled then return end
    if isLobbyMacro() or knifeEquipped() then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        runMacro()
    elseif input.UserInputType == Enum.UserInputType.Touch then
        local cam = Workspace.CurrentCamera; local width = cam and cam.ViewportSize.X or 0
        if width > 0 and input.Position.X >= width * macroTouch.MinXFraction then
            local startPos = Vector2.new(input.Position.X, input.Position.Y)
            macroTouch.Active[input]   = startPos
            macroTouch.StartPos[input] = startPos
            macroTouch.WasDrag[input]  = false
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    local start = macroTouch.StartPos[input]
    if start then
        local delta = (Vector2.new(input.Position.X, input.Position.Y) - start).Magnitude
        if delta > macroTouch.DragPx then
            macroTouch.WasDrag[input] = true; macroTouch.Active[input] = nil
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local wasDrag  = macroTouch.WasDrag[input]
        local wasActive = macroTouch.Active[input]
        macroTouch.Active[input] = nil; macroTouch.StartPos[input] = nil; macroTouch.WasDrag[input] = nil
        touchHeld = next(macroTouch.Active) ~= nil
        if wasActive and not wasDrag then
            if macroEnabled and not isLobbyMacro() and not knifeEquipped() then task.spawn(runMacro) end
        end
    end
end)

UserInputService.WindowFocusReleased:Connect(function()
    table.clear(macroTouch.Active); table.clear(macroTouch.StartPos); table.clear(macroTouch.WasDrag); touchHeld = false
end)

-- ═══════════════════════════════════════════════════════════════
--  AUTO EQUIP  ✅ FIX 1: separated RespetarCuchillo + Respetar25 per system
-- ═══════════════════════════════════════════════════════════════
do
    local AE_SETTLE=0.04; local AE_FIRE_HOLD=0.08; local AE_AUTO_COOLDOWN=0.15
    local AE_SHOT_HOLD=0.12; local AE_REEQUIP_DELAY=0.5; local AE_TICK=0.05

    local function aliveHumanoid()
        local character = player.Character; local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if character and humanoid and humanoid.Health > 0 then return character, humanoid end; return nil, nil
    end

    local function equipGun()
        local character, humanoid = aliveHumanoid(); if not character then return nil end
        if character:FindFirstChildOfClass("Tool") then return nil end
        local gun = getGun(); if not gun then return nil end
        pcall(function() humanoid:EquipTool(gun) end); task.wait(AE_SETTLE)
        if gun.Parent ~= player.Character then return nil end; return gun
    end

    local function holster(gun)
        local character, humanoid = aliveHumanoid()
        if not character or not gun or gun.Parent ~= character then return end
        pcall(function() humanoid:UnequipTools() end)
        autoEquip.LastHolsterAt = os.clock()
    end

    -- ✅ FIX 1: canAutoEquip checks nothing about knife — knife guard is inline per loop
    local function canAutoEquip()
        return not destroyed and not autoEquip.Busy and not macroBusy
            and not SilentIsDead and not isLobbyMacro()
    end

    -- ✅ FIX 1: AutoShot equip loop uses RespetarCuchilloAuto + Respetar25Auto
    -- Also added explicit knifeEquipped() check that ALWAYS blocks when flag is on,
    -- and clears state correctly on tool removal via a character watcher
    task.spawn(function()
        while not destroyed do
            task.wait(AE_TICK)
            if autoEquip.Auto and autoShoot.Enabled and canAutoEquip() then
                -- ✅ if RespetarCuchilloAuto is on and knife is currently held → skip entirely
                if autoEquip.RespetarCuchilloAuto and knifeEquipped() then
                    -- do nothing, respect knife
                elseif autoEquip.Respetar25Auto and (os.clock() - autoEquip.LastHolsterAt) < 2.5 then
                    -- do nothing, respect 2.5s cooldown
                else
                    local character = player.Character
                    if character then
                        -- ✅ FIX KNIFE-FOV: if knife is equipped and RespetarCuchillo is OFF,
                        -- holster the knife first so we can equip the gun
                        local currentTool = character:FindFirstChildOfClass("Tool")
                        if currentTool and isKnife(currentTool) and not autoEquip.RespetarCuchilloAuto then
                            -- only swap if there's actually an enemy in FOV worth shooting
                            local part = getBestTarget(autoShoot.TargetPart, autoShoot.FOVSize)
                            if part then
                                local hum = character:FindFirstChildOfClass("Humanoid")
                                if hum then
                                    pcall(function() hum:UnequipTools() end)
                                    autoEquip.LastHolsterAt = os.clock()
                                    task.wait(AE_SETTLE)
                                    -- refresh ref after wait so we see updated tool state
                                    character = player.Character
                                end
                            end
                        end
                        -- now proceed only if no tool is equipped (either was bare or just holstered)
                        if character and not character:FindFirstChildOfClass("Tool") then
                            local part = getBestTarget(autoShoot.TargetPart, autoShoot.FOVSize)
                            if part then
                                autoEquip.Busy = true
                                local ok, err = pcall(function()
                                    local gun = equipGun()
                                    if gun then
                                        local still = autoShoot.Enabled and autoEquip.Auto and getBestTarget(autoShoot.TargetPart, autoShoot.FOVSize)
                                        if still and gun.Parent == player.Character then
                                            pcall(function() gun:Activate() end); task.wait(AE_FIRE_HOLD); pcall(function() gun:Deactivate() end)
                                        end
                                        holster(gun)
                                    end
                                end)
                                autoEquip.Busy = false
                                if not ok then warn("[Xitado] AutoEquip Auto: "..tostring(err)) end
                                task.wait(AE_AUTO_COOLDOWN)
                            end
                        end
                    end
                end
            end
        end
    end)

    local hold = nil; local reequipAt = 0
    local function releaseHold(doHolster)
        local h = hold; hold = nil; if not h then return end
        for _, c in ipairs(h.conns) do pcall(function() c:Disconnect() end) end
        if doHolster then holster(h.gun) end; reequipAt = os.clock() + AE_REEQUIP_DELAY
    end

    -- ✅ FIX 1: Silent equip loop uses RespetarCuchilloSilent + Respetar25Silent
    task.spawn(function()
        while not destroyed do
            task.wait(AE_TICK)
            if not (autoEquip.Silent and silentAim.Enabled) or SilentIsDead or isLobbyMacro() then
                if hold then releaseHold(true) end
            elseif hold then
                local character = player.Character
                if not character or hold.gun.Parent ~= character then releaseHold(false)
                elseif hold.hum.Health <= 0 or not hold.hum.Parent then releaseHold(true)
                elseif hold.shotAt and os.clock()-hold.shotAt >= AE_SHOT_HOLD then releaseHold(true) end
            elseif os.clock() >= reequipAt and canAutoEquip() then
                -- ✅ FIX 1: use the SILENT-specific flags
                if autoEquip.RespetarCuchilloSilent and knifeEquipped() then
                    -- skip
                elseif autoEquip.Respetar25Silent and (os.clock() - autoEquip.LastHolsterAt) < 2.5 then
                    -- skip
                else
                    local character = player.Character
                    if character and not character:FindFirstChildOfClass("Tool") then
                        local part = getBestTarget(silentAim.TargetPart, silentAim.FOVSize)
                        local targetChar = part and part.Parent
                        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                        if targetHum then
                            autoEquip.Busy = true
                            local ok, gun = pcall(equipGun); autoEquip.Busy = false
                            if ok and gun then
                                local h = { gun=gun, hum=targetHum, shotAt=nil, conns={} }
                                table.insert(h.conns, gun.Activated:Connect(function()
                                    if hold==h and not h.shotAt then h.shotAt = os.clock() end
                                end))
                                hold = h
                            end
                        end
                    end
                end
            end
        end
    end)

    -- ✅ FIX 1: When the knife is unequipped (put away), re-arm the system immediately
    -- so toggling knife off doesn't leave a stale "knife was equipped" state
    player.CharacterAdded:Connect(function(char)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") and isKnife(child) then
                -- knife was unequipped — no extra state needed, loops re-evaluate each tick
            end
        end)
    end)
    if player.Character then
        player.Character.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") and isKnife(child) then
                -- re-evaluate next tick automatically
            end
        end)
    end
end

-- ═══════════════════════════════════════════════════════════════
--  CAMLOCK
-- ═══════════════════════════════════════════════════════════════
local camlockEnabled=false; local camlockGunOnly=false; local camlockKnifeOnly=false; local camlockTarget=nil
local CAMLOCK_PREDICTION=0.18; local CAMLOCK_MAX_DIST=900; local CAMLOCK_FOV_PX=260; local CAMLOCK_LERP=0.10
local camlockLastFrame=os.clock()
local camlockRayParams=RaycastParams.new(); camlockRayParams.FilterType=Enum.RaycastFilterType.Exclude

local function camlockPuedeActivar()
    if not camlockEnabled then return false end
    local char = player.Character; local tool = char and char:FindFirstChildOfClass("Tool")
    if camlockGunOnly and camlockKnifeOnly then return tool and (isGun(tool) or isKnife(tool))
    elseif camlockGunOnly then return tool and isGun(tool)
    elseif camlockKnifeOnly then return tool and isKnife(tool) end
    return true
end

local function getCamlockAimPart(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local function camlockVisible(from, part, myChar)
    if not part or not part.Parent then return false end
    local enemyChar = part:FindFirstAncestorOfClass("Model") or part.Parent
    camlockRayParams.FilterDescendantsInstances = { myChar, enemyChar }
    local dir = part.Position - from; local hit = Workspace:Raycast(from, dir, camlockRayParams)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(enemyChar)
end

local function FindNearestEnemyCamlock()
    local myChar = player.Character; if not myChar then return nil end
    local myHead = myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"); if not myHead then return nil end
    local cam = Workspace.CurrentCamera; if not cam then return nil end
    local screenCenter = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local origin = myHead.Position; local bestPart, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and isEnemy(p) then
            local char = p.Character
            if char then
                local aimPart = getCamlockAimPart(char)
                if aimPart and aimPart:IsA("BasePart") then
                    local dist3d = (aimPart.Position - origin).Magnitude
                    if dist3d <= CAMLOCK_MAX_DIST then
                        local pos2d, onScreen = cam:WorldToViewportPoint(aimPart.Position)
                        if onScreen and pos2d.Z > 0 then
                            local screenDist = (screenCenter - Vector2.new(pos2d.X, pos2d.Y)).Magnitude
                            if screenDist <= CAMLOCK_FOV_PX and camlockVisible(origin, aimPart, myChar) then
                                local score = screenDist + dist3d * 0.05
                                if score < bestScore then bestScore = score; bestPart = aimPart end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

RunService.RenderStepped:Connect(function()
    local now = os.clock(); local dt = math.clamp(now-camlockLastFrame, 0, 1/20); camlockLastFrame = now
    if not camlockPuedeActivar() then camlockTarget = nil; return end
    local cam = Workspace.CurrentCamera; local myChar = player.Character
    local myHead = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
    if not cam or not myHead then camlockTarget = nil; return end
    local needNew = not (camlockTarget and camlockTarget.Parent)
    if not needNew then
        local enemyChar = camlockTarget:FindFirstAncestorOfClass("Model")
        local targetPlayer = enemyChar and Players:GetPlayerFromCharacter(enemyChar)
        local screenPos, onScreen = cam:WorldToViewportPoint(camlockTarget.Position)
        if not targetPlayer or not isEnemy(targetPlayer) or not onScreen or screenPos.Z <= 0
            or (camlockTarget.Position - myHead.Position).Magnitude > CAMLOCK_MAX_DIST
            or not camlockVisible(myHead.Position, camlockTarget, myChar) then needNew = true end
    end
    if needNew then camlockTarget = FindNearestEnemyCamlock() end
