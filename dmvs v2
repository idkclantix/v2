local function showNotice(text, title)
    text = tostring(text or "")
    title = tostring(title or "Xitado Hub")
    local roots = { CoreGui }
    pcall(function()
        if gethui then local h = gethui(); if h then roots[#roots+1] = h end end
        local pg = player:FindFirstChildOfClass("PlayerGui"); if pg then roots[#roots+1] = pg end
    end)
    local function noticeShown()
        for _, root in ipairs(roots) do
            if root then
                for _, o in ipairs(root:GetDescendants()) do
                    if o:IsA("TextLabel") and tostring(o.Text or "") == text then return true end
                end
            end
        end
        return false
    end
    local okApi = false
    pcall(function()
        if WindUI and type(WindUI.Notify) == "function" then
            WindUI:Notify({ Title = title, Content = text, Duration = 3 }); okApi = true
        elseif Window and type(Window.Notify) == "function" then
            Window:Notify({ Title = title, Content = text, Duration = 3 }); okApi = true
        end
    end)
    task.delay(0.25, function()
        if destroyed or (okApi and noticeShown()) then return end
        pcall(function()
            local gui = Instance.new("ScreenGui")
            gui.Name = "XitadoAuraNotify"
            gui.ResetOnSpawn = false
            gui.IgnoreGuiInset = true
            local hOk, h = pcall(function() return gethui and gethui() end)
            gui.Parent = (hOk and h) or CoreGui
            local box = Instance.new("Frame")
            box.Name = "Box"
            box.Size = UDim2.fromOffset(300, 62)
            box.Position = UDim2.new(1, -320, 0, 96)
            box.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            box.BorderSizePixel = 0
            box.Parent = gui
