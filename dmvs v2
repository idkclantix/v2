end

local function triggerTargetValid(targetPlayer, character)
    if not targetPlayer or targetPlayer == player then return false end
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if character:FindFirstChildOfClass("ForceField") then return false end
    if not isEnemy(targetPlayer) then return false end
    if targetPlayer.Team then
        local tName = string.lower(targetPlayer.Team.Name)
        if string.find(tName,"lobby") or string.find(tName,"spectat") or string.find(tName,"espectador") or string.find(tName,"menu") or string.find(tName,"dead") then return false end
    end
    return true
end

task.spawn(function()
