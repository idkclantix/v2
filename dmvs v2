                for otherName, otherHandle in pairs(AnimState.Toggles) do
                    if otherName ~= pack.Name then pcall(function() if otherHandle.Set then otherHandle:Set(false) end end) end
                end
                AnimState.Switching = false
                AnimState.Selected = pack.Ids
                AnimState.SelectedName = pack.Name
                task.spawn(function() ApplyAnims(pack.Ids) end)
            else
                if AnimState.SelectedName == pack.Name then
                    AnimState.Selected = nil
                    AnimState.SelectedName = nil
                    task.spawn(RestoreOriginalAnims)
                end
            end
        end,
    })
