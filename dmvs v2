-- Autoequip: se dispara apenas se ve CUALQUIER parte del enemigo (como 01rox).
local autoEquipRayParams = RaycastParams.new()
autoEquipRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function autoEquipEnemyPartVisible()
    local char = player.Character
    if not char then return false end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return false end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local viewport = cam.ViewportSize
    local origin = head.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and esEnemigoValido(p) then
            local pChar = p.Character
            if pChar then
                autoEquipRayParams.FilterDescendantsInstances = { char, pChar }
                for _, part in ipairs(pChar:GetChildren()) do
                    if part:IsA("BasePart") then
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 and sp.X >= -40 and sp.X <= viewport.X + 40 and sp.Y >= -40 and sp.Y <= viewport.Y + 40 then
                            local size = part.Size
                            local offsets = { Vector3.zero, Vector3.new(0, size.Y / 2.1, 0), Vector3.new(0, -size.Y / 2.1, 0) }
                            for _, off in ipairs(offsets) do
                                local hit = workspace:Raycast(origin, (part.CFrame * off) - origin, autoEquipRayParams)
                                if not hit or (hit.Instance and hit.Instance:IsDescendantOf(pChar)) then return true end
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

