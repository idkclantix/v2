end

local function rebuildPerfHUD()
    buildPerfHUD(); applyPerfHUDVisibility()
    if perfHUD.Conn then perfHUD.Conn:Disconnect(); perfHUD.Conn = nil end
    perfHUD._fpsAccum = 0; perfHUD._fpsFrames = 0; perfHUD._fpsTimer = 0; perfHUD._lastFPS = 0
    perfHUD.Conn = RunService.Heartbeat:Connect(function(dt)
        if not (perfHUD.ShowFPS or perfHUD.ShowPing) then return end
        perfHUD._fpsAccum = perfHUD._fpsAccum + dt
        perfHUD._fpsFrames = perfHUD._fpsFrames + 1
        perfHUD._fpsTimer = perfHUD._fpsTimer + dt
        if perfHUD._fpsTimer >= 0.25 then
            local fps = math.round(perfHUD._fpsFrames / perfHUD._fpsAccum)
            perfHUD._lastFPS = fps
            perfHUD._fpsAccum = 0; perfHUD._fpsFrames = 0; perfHUD._fpsTimer = 0
            if perfHUD.FpsLabel and perfHUD.ShowFPS then
                local c = fps >= 60 and Color3.fromRGB(100, 220, 130) or (fps >= 30 and Color3.fromRGB(230, 200, 60) or Color3.fromRGB(230, 80, 80))
                perfHUD.FpsLabel.TextColor3 = c
                perfHUD.FpsLabel.Text = "FPS  " .. tostring(fps)
            end
            if perfHUD.PingLabel and perfHUD.ShowPing then
                local ping = 0
                pcall(function() ping = math.round(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end)
                local c = ping <= 80 and Color3.fromRGB(100, 180, 255) or (ping <= 150 and Color3.fromRGB(230, 200, 60) or Color3.fromRGB(230, 80, 80))
                perfHUD.PingLabel.TextColor3 = c
                perfHUD.PingLabel.Text = "PING " .. tostring(ping) .. "ms"
            end
        end
    end)
end

