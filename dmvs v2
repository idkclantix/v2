local MOD_KILL_STAT_NAMES = {
    kos = true, kills = true, kill = true, ko = true, killed = true,
    eliminations = true, kills_count = true,
}
local MOD_KILL_ATTR_NAMES = { "KOs", "Kills", "kos", "kills", "KO", "killed", "Eliminations" }
local function modKillSignal()
    modLastLocalKillSignal = os.clock()
    modConfirmLocalKill(nil, nil)
end
local function modHookKillStat(stat)
    if not stat or not (stat:IsA("IntValue") or stat:IsA("NumberValue")) then return end
    if not MOD_KILL_STAT_NAMES[string.lower(stat.Name)] or stat:GetAttribute("XitadoModKillHooked") then return end
    stat:SetAttribute("XitadoModKillHooked", true)
    local last = stat.Value
    table.insert(modStatConns, stat:GetPropertyChangedSignal("Value"):Connect(function()
        local now = stat.Value
        if now > last then modKillSignal() end
        last = now
    end))
end
local function modHookKillContainer(container)
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do modHookKillStat(child) end
    table.insert(modStatConns, container.ChildAdded:Connect(modHookKillStat))
end
local function modStartKillStatHooks()
    if modStatsHooked then return end
    modStatsHooked = true
    for _, name in ipairs(MOD_KILL_ATTR_NAMES) do
        local last = tonumber(player:GetAttribute(name))
        table.insert(modStatConns, player:GetAttributeChangedSignal(name):Connect(function()
            local now = tonumber(player:GetAttribute(name))
            if now ~= nil and last ~= nil and now > last then modKillSignal() end
            last = now
        end))
    end
    local containers = {}
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then containers[#containers + 1] = leaderstats end
    for _, name in ipairs({ "Stats", "stats", "PlayerStats" }) do
        local c = player:FindFirstChild(name)
        if c then containers[#containers + 1] = c end
    end
    for _, c in ipairs(containers) do modHookKillContainer(c) end
    table.insert(modStatConns, player.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" or child.Name == "Stats" or child.Name == "stats" or child.Name == "PlayerStats" then
            modHookKillContainer(child)
        end
    end))
end

local function modOnEnemyDied(char)
    if destroyed or not char or modPendingDeath[char] then return end
    modPendingDeath[char] = true
    -- Logica de clanxitado: el tag "creator" del Humanoid confirma que el kill fue nuestro
    local hum = char:FindFirstChildOfClass("Humanoid")
    local tag = hum and hum:FindFirstChild("creator")
    local tagConfirmed = tag ~= nil and tag.Value == player
    if not tagConfirmed and (modDestroyEvent or (os.clock() - modLastLocalKillSignal) > 1.5) then
        task.delay(1, function() modPendingDeath[char] = nil end)
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    modConfirmLocalKill(char, root and root.CFrame or nil)
    task.delay(1, function() modPendingDeath[char] = nil end)
end
local function modBindKillDetection(plr, char)
    if not plr or plr == player or not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if not hum then return end
    table.insert(modKillConns, hum.Died:Connect(function() modOnEnemyDied(char) end))
    table.insert(modKillConns, hum.HealthChanged:Connect(function(h)
        if h <= 0 then modOnEnemyDied(char) end
    end))
end
local function modStopKillDetection()
    for _, c in ipairs(modKillConns) do pcall(function() c:Disconnect() end) end
    table.clear(modKillConns)
end
local function modStartKillDetection()
    modStopKillDetection()
    modStartDestroyRemoteHook()
    modStartKillStatHooks()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            if plr.Character then task.defer(modBindKillDetection, plr, plr.Character) end
            table.insert(modKillConns, plr.CharacterAdded:Connect(function(char)
                task.wait(0.1)
                if not destroyed then modBindKillDetection(plr, char) end
            end))
        end
    end
    table.insert(modKillConns, Players.PlayerAdded:Connect(function(plr)
        if plr == player then return end
        table.insert(modKillConns, plr.CharacterAdded:Connect(function(char)
            task.wait(0.1)
            if not destroyed then modBindKillDetection(plr, char) end
        end))
    end))
end

