-- WindUI no expone SetTitle en las tabs: hay que tocar el TextLabel interno segun la version.
local function setTabTitle(tab, text)
    if not tab then return end
    text = tostring(text)
    pcall(function() tab.Title = text end)
    pcall(function()
        local uis = tab.UIElements
        if not uis then return end

        local function setText(obj)
            if typeof(obj) == "Instance" and obj:IsA("TextLabel") then obj.Text = text end
        end

        -- version con TabItem
        local tabItem = uis.TabItem
        if tabItem then
            pcall(function()
                setText(tabItem)
                local frame = tabItem.Frame
                if frame then
                    setText(frame)
                    if frame.Title then
                        setText(frame.Title)
                        setText(frame.Title.TextLabel)
                    end
                end
            end)
        end

        -- version con Main
        local main = uis.Main
        if main then
            pcall(function()
                setText(main)
                local frame = main.Frame
                if frame then
                    setText(frame)
                    for _, d in ipairs(frame:GetDescendants()) do setText(d) end
                end
            end)
        end
    end)
end

