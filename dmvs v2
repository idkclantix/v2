ModShootSoundPlayer.Volume = 1
ModShootSoundPlayer.Parent = SoundService
local modShootConns = {}
local modFireWatched = setmetatable({}, { __mode = "k" })
local modLastShootSound = 0
local MOD_SHOOT_MIN_INTERVAL = 0.2
local MOD_FIRE_KEYWORDS = { "fire", "shoot", "shot", "gun", "burst", "shotgun", "gunshot", "muzzle", "rifle", "pistol", "shooting", "firing" }
local function modIsFireSound(s)
    if not s or not s:IsA("Sound") then return false end
    local n = string.lower(s.Name)
    if string.find(n, "xitado", 1, true) then return false end
    for _, kw in ipairs(MOD_FIRE_KEYWORDS) do
        if string.find(n, kw, 1, true) then return true end
    end
    return false
end
local function modPlayShootSound()
    if not modShootSound.Enabled then return end
    local id = ModShootSounds[modShootSound.Selected]
    if not id then return end
    local now = os.clock()
    if now - modLastShootSound < MOD_SHOOT_MIN_INTERVAL then return end
    modLastShootSound = now
    pcall(function()
        ModShootSoundPlayer:Stop()
        ModShootSoundPlayer.SoundId = "rbxassetid://" .. id
        ModShootSoundPlayer.Volume = modShootSound.Volume or 2.5
        ModShootSoundPlayer:Play()
    end)
    task.delay(1.5, function()
        if os.clock() - modLastShootSound >= 1.5 then pcall(function() ModShootSoundPlayer:Stop() end) end
    end)
end
local function modHookFireSound(s)
    if not s:IsA("Sound") or not modIsFireSound(s) or modFireWatched[s] then return end
    modFireWatched[s] = true
    if modShootSound.Enabled and s:GetAttribute("XitadoModOrigVol") == nil then
        s:SetAttribute("XitadoModOrigVol", s.Volume)
        pcall(function() s.Volume = 0 end)
    end
    table.insert(modShootConns, s.Played:Connect(function()
        if not modShootSound.Enabled then return end
        local char = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")
        if char and (s:IsDescendantOf(char) or (backpack and s:IsDescendantOf(backpack))) then
            pcall(function() s.Volume = 0 end)
            modPlayShootSound()
        end
    end))
end
local function modHookToolSounds(tool)
    if not tool or not tool:IsA("Tool") then return end
    for _, d in ipairs(tool:GetDescendants()) do modHookFireSound(d) end
    table.insert(modShootConns, tool.DescendantAdded:Connect(modHookFireSound))
end
local function modHookRoot(root)
    if not root then return end
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("Tool") then modHookToolSounds(child) end
    end
    table.insert(modShootConns, root.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then modHookToolSounds(child) end
    end))
end
local function modStopShootWatchers()
    for _, c in ipairs(modShootConns) do pcall(function() c:Disconnect() end) end
    table.clear(modShootConns)
    for s in pairs(modFireWatched) do
        local orig = s:GetAttribute("XitadoModOrigVol")
        if orig ~= nil then
            pcall(function() s.Volume = orig end)
            pcall(function() s:SetAttribute("XitadoModOrigVol", nil) end)
        end
    end
    table.clear(modFireWatched)
end
local function modStartShootWatchers()
    modStopShootWatchers()
    local char = player.Character
    if char then modHookRoot(char) end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then modHookRoot(backpack) end
    table.insert(modShootConns, player.CharacterAdded:Connect(function(c)
        task.wait(0.2)
        if not destroyed and modShootSound.Enabled then modHookRoot(c) end
    end))
end

