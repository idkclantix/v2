local LOCAL_HIT_WINDOW = 1.5; local AIM_CONE_DOT = math.cos(math.rad(20))
local localDamagedChars = setmetatable({},{__mode="k"})
local GUN_HOLSTER_GRACE = 1.0; local lastGunHolsteredAt = { t = 0 }
local function watchLocalGun(char)
    if not char then return end
    char.ChildRemoved:Connect(function(child) if child:IsA("Tool") and isGun(child) then lastGunHolsteredAt.t = tick() end end)
end
if player.Character then watchLocalGun(player.Character) end
