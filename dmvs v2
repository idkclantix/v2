    local AURA_ARG="959d5e90-231d-4f6e-8861-050e2c22b938"; local AURA_RANGE=20; local AURA_COOLDOWN=0.3
    local aura={Enabled=false,Remote=nil,Conn=nil,Acc=0}; local auraHook={Installed=false,Active=false}

    local function installAuraHook()
        if auraHook.Installed then auraHook.Active=true; return true end
        if not (getrawmetatable and setreadonly and newcclosure and getnamecallmethod) then
            M.Notify("Knife Aura: tu ejecutor no soporta hooks"); return false
        end
        local mt; local ok=pcall(function()
            mt=getrawmetatable(game); local old=mt.__namecall; local wrapper
            wrapper=newcclosure(function(self,...)
                if not auraHook.Active then return old(self,...) end
                local method=getnamecallmethod()
                if method=="FireServer" then
                    local first=...
                    if first==AURA_ARG then
                        aura.Remote=self; auraHook.Active=false
                        pcall(function()
                            if rawget(mt,"__namecall")==wrapper then
                                setreadonly(mt,false); mt.__namecall=old; setreadonly(mt,true); auraHook.Installed=false
                            end
                        end)
                    end
                end
                return old(self,...)
            end)
            setreadonly(mt,false); mt.__namecall=wrapper; setreadonly(mt,true)
        end)
        if not ok then if mt then pcall(function() setreadonly(mt,true) end) end; M.Notify("Knife Aura: hook fallido"); return false end
        auraHook.Installed=true; auraHook.Active=true; return true
    end

    local function auraStep()
        local remote=aura.Remote; if not remote then return end
        local char=player.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local tool=char:FindFirstChildOfClass("Tool"); local handle=tool and tool:FindFirstChild("Handle"); if not handle then return end
        local myPos=hrp.Position; local bestHrp,bestDist=nil,math.huge
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=player and plr.Character then
                local thrp=plr.Character:FindFirstChild("HumanoidRootPart")
                local thum=plr.Character:FindFirstChildOfClass("Humanoid")
                if thrp and thum and thum.Health>0 then
                    local d=(thrp.Position-myPos).Magnitude; if d<bestDist then bestDist=d; bestHrp=thrp end
                end
