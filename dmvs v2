local function getButtonLayout(side, order)
    local y = (order - 2.5) * (BUTTON_H + BUTTON_GAP)
    if side == "left" then
        return UDim2.new(0, BUTTON_EDGE, 0.5, y), Vector2.new(0, 0.5)
    end
    return UDim2.new(1, -BUTTON_EDGE, 0.5, y), Vector2.new(1, 0.5)
end

-- Zigzag: el primer boton visible a la izquierda, el siguiente a la derecha,
-- el tercero a la izquierda... segun el orden en que se fueron prendiendo.
local function layoutVisibleButtons()
    local leftCount, rightCount = 0, 0
    for i, id in ipairs(buttonOrder) do
        local fb, def = buttons[id], buttonDefs[id]
        if def and fb and fb.Button and fb.Button.Parent and fb.Button.Visible then
            local side = (i % 2 == 1) and "left" or "right"
            local idx
            if side == "left" then
                leftCount = leftCount + 1; idx = leftCount
            else
                rightCount = rightCount + 1; idx = rightCount
            end
            def.side, def.order = side, idx
            local pos, anchor = getButtonLayout(side, idx)
            pcall(function()
                fb.Button.AnchorPoint = anchor
                fb.Button.Position = pos
            end)
        end
    end
end

local function setButtonState(fb, label, state)
    if not fb or not fb.Button then return end
    pcall(function()
        fb.Button.Text = label .. (state and ": ON" or ": OFF")
        fb.Button.TextColor3 = state
            and Color3.fromRGB(168, 199, 250)
            or Color3.fromRGB(248, 250, 252)
        if fb.Stroke then
            fb.Stroke.Color = state
                and Color3.fromRGB(255, 255, 255)
                or Color3.fromRGB(42, 42, 61)
        end
    end)
end

local function makeFloatingButton(id, def)
    local parent = ensureFloatGui()
    local pos, anchor = getButtonLayout(def.side, def.order)
    local btn = Instance.new("TextButton")
    btn.Name = "XitadoBtn" .. id
    btn.AnchorPoint = anchor
    btn.Position = pos
    btn.Size = UDim2.fromOffset(BUTTON_W, BUTTON_H)
    btn.BackgroundColor3 = Color3.fromRGB(10, 10, 16)
    btn.BackgroundTransparency = 0.3
    btn.AutoButtonColor = false
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(248, 250, 252)
    btn.ZIndex = 50
    btn.Selectable = false
    btn.Visible = false
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.2
    stroke.Color = Color3.fromRGB(42, 42, 61)
    stroke.Transparency = 0.5
    stroke.Parent = btn

    local dragging, moved, pressInput, dragStart, startPos = false, false, nil, nil, nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        moved = false
        pressInput = input
        dragStart = input.Position
        startPos = btn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end)
    table.insert(floatConns, UserInputService.InputChanged:Connect(function(input)
        if not dragging or input ~= pressInput then return end
        local delta = input.Position - dragStart
        if delta.Magnitude > 12 then
            moved = true
            if not buttonsLocked then
                btn.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))
    btn.MouseButton1Click:Connect(function()
        if not moved then pcall(def.onClick) end
    end)
    btn.MouseEnter:Connect(function()
        pcall(function()
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(26, 26, 36),
                BackgroundTransparency = 0.1,
            }):Play()
        end)
    end)
    btn.MouseLeave:Connect(function()
        pcall(function()
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(10, 10, 16),
                BackgroundTransparency = 0.3,
            }):Play()
        end)
    end)
    return { Gui = btn, Button = btn, Stroke = stroke }
end

local function SetButtonVisible(id, on)
    on = on == true
    local def = buttonDefs[id]
    if not def then return end
    local fb = buttons[id]
    if on and not (fb and fb.Button and fb.Button.Parent) then
        fb = makeFloatingButton(id, def)
        buttons[id] = fb
        refreshButtons()
    end
    if fb and fb.Button then fb.Button.Visible = on end
    -- Actualiza el orden de activacion y reubica en zigzag
    for i = #buttonOrder, 1, -1 do
        if buttonOrder[i] == id then table.remove(buttonOrder, i) end
    end
    if on then table.insert(buttonOrder, id) end
    layoutVisibleButtons()
    local anyVisible = false
    for _, b in pairs(buttons) do
        if b.Button and b.Button.Parent and b.Button.Visible then anyVisible = true end
    end
    if anyVisible and not pollConn then
        pollConn = RunService.Heartbeat:Connect(function(dt)
            pollAcc = pollAcc + dt
            if pollAcc < 0.2 then return end
            pollAcc = 0
            refreshButtons()
        end)
    elseif not anyVisible and pollConn then
        pollConn:Disconnect(); pollConn = nil
    end
end

