local function obtenerCuchillo()
    local char = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if char then for _, item in ipairs(char:GetChildren()) do if esCuchillo(item) then return item end end end
    if backpack then for _, item in ipairs(backpack:GetChildren()) do if esCuchillo(item) then return item end end end
    return nil
end

-- Logica anterior del aura: mientras este activa, el cuchillo SIEMPRE equipado
-- en partida; en lobby se detiene con el detector estaEnLobby() (ya con PLAY/JUGAR).
local function forceKnifeEquipped()
    if not auraState.Enabled then return end
    if estaEnLobby() then return end -- en el lobby jamas se equipa el cuchillo
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local held = char:FindFirstChildOfClass("Tool")
    if held and esCuchillo(held) then return end
    local knife = obtenerCuchillo()
    if not knife then return end
    pcall(function() hum:EquipTool(knife) end)
end

local function auraStep()
    if estaEnLobby() then return end
    local remote = auraRemote
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or not esCuchillo(tool) then return end -- el aura solo golpea con cuchillo
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local myPos = hrp.Position
    local bestRoot, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and isEnemy(plr) then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local d = (root.Position - myPos).Magnitude
                if d < bestDist then bestDist = d; bestRoot = root end
            end
        end
    end
    if not bestRoot or bestDist > AURA_RANGE then return end
    if firetouchinterest then pcall(function() firetouchinterest(handle, bestRoot, 0); firetouchinterest(handle, bestRoot, 1) end) end
    if remote then pcall(function() remote:FireServer(AURA_ARG) end)
    else pcall(function() tool:Activate() end) end
end

