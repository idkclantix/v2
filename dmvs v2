-- ═══════════════════════════════════════════════════════════════
local autoEventFarm = { Active=false, Remote=nil }

local function getEventRemote()
    if autoEventFarm.Remote and autoEventFarm.Remote.Parent then return autoEventFarm.Remote end
    local packages=ReplicatedStorage:FindFirstChild("Packages"); if not packages then return nil end
    local networking=packages:FindFirstChild("Networking"); if not networking then return nil end
    local remote=networking:FindFirstChild("RE/Events/CollectEventSpawnable")
    autoEventFarm.Remote=remote; return remote
end

local function collectEventObj(obj)
    if not obj or not obj.Parent then return end
    local remote=getEventRemote(); if remote then pcall(function() remote:FireServer(obj) end) end
    local char=player.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local touchPart=obj:FindFirstChild("Touch") or obj:FindFirstChildWhichIsA("BasePart",true); if not touchPart then return end
    if firetouchinterest then pcall(function() firetouchinterest(hrp,touchPart,0); task.wait(0.01); firetouchinterest(hrp,touchPart,1) end) end
end

local function runEventFarmLoop()
    task.spawn(function()
        getEventRemote()
        while autoEventFarm.Active do
            pcall(function()
                local char=player.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
                local container=Workspace:FindFirstChild("SpawnablesClient"); if not container then return end
                for _,obj in ipairs(container:GetChildren()) do
                    if not autoEventFarm.Active then break end
                    if obj:IsA("Model") or obj:IsA("BasePart") then collectEventObj(obj); task.wait(0.02) end
                end
            end)
            task.wait(0.05)
        end
    end)
end

task.spawn(function()
    local wasInMatch=false
    while not destroyed do
        local inMatch=isInMatch()
        if inMatch and not wasInMatch then autoEventFarm.Active=true; runEventFarmLoop()
        elseif not inMatch and wasInMatch then autoEventFarm.Active=false end
        wasInMatch=inMatch; task.wait(1)
    end
end)

