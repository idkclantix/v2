local function triggerTargetVisible(character)
    local cam = Workspace.CurrentCamera
    local myChar = player.Character
    if not cam or not character or not myChar then return false end
    local samples = {
        character:FindFirstChild("Head"),
        character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"),
        character:FindFirstChild("HumanoidRootPart"),
    }
    triggerRayParams.FilterDescendantsInstances = { myChar, character }
    local visible = 0
    for _, part in ipairs(samples) do
        if part and part:IsA("BasePart") then
            local sp, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen and sp.Z > 0 then
                local hit = Workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, triggerRayParams)
                if not hit then
                    visible = visible + 1
                    if visible >= 2 then return true end
                end
            end
        end
    end
    return false
end

local function triggerGetAimTarget()
    local cam = Workspace.CurrentCamera
