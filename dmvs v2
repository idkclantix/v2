local function collectAllSpawnables()
    if destroyed or estaEnLobby() then return end
    local container = Workspace:FindFirstChild("SpawnablesClient")
    if not container then return end
    getEventRemote()
    for _, obj in ipairs(container:GetChildren()) do
        if not autoEventFarm.Active or destroyed then break end
        if obj:IsA("Model") or obj:IsA("BasePart") then
            collectEventObj(obj)
            task.wait(0.01)
        end
    end
end

local function startFarmLoop()
    autoEventFarm.Gen = autoEventFarm.Gen + 1
    local gen = autoEventFarm.Gen
    task.spawn(function()
        while gen == autoEventFarm.Gen and autoEventFarm.Active and not destroyed do
            pcall(collectAllSpawnables)
            task.wait(0.15) -- barre todo de una al instante
        end
    end)
end

