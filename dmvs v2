local function captureOriginalAnims(char)
    if AnimState.Original then return end
    local Animate = char and char:FindFirstChild("Animate")
    if not Animate then return end
    local function getId(parentName, childName)
        local p = Animate:FindFirstChild(parentName)
        local a = p and p:FindFirstChild(childName)
        if a and a:IsA("Animation") then return a.AnimationId end
        return nil
    end
    AnimState.Original = {
        idle1 = getId("idle", "Animation1"), idle2 = getId("idle", "Animation2"),
        walk = getId("walk", "WalkAnim"), run = getId("run", "RunAnim"),
        jump = getId("jump", "JumpAnim"), fall = getId("fall", "FallAnim"),
    }
end

local function ApplyAnims(ids)
    local char = player.Character
    if not char or not ids then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local Animate = char:FindFirstChild("Animate")
    if not Animate or not hum then return end
    captureOriginalAnims(char)
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() track:Stop(0) end) end
    end
    local function setAnimId(parentName, childName, newId)
        local p = Animate:FindFirstChild(parentName)
        if p then
            local a = p:FindFirstChild(childName)
            if a and a:IsA("Animation") then a.AnimationId = newId or "rbxassetid://0" end
        end
    end
    setAnimId("idle", "Animation1", ids.idle1)
    setAnimId("idle", "Animation2", ids.idle2)
    setAnimId("walk", "WalkAnim", ids.walk)
    setAnimId("run", "RunAnim", ids.run)
    setAnimId("jump", "JumpAnim", ids.jump)
    setAnimId("fall", "FallAnim", ids.fall)
    pcall(function() Animate.Enabled = false end)
    task.wait(0.03)
    pcall(function() Animate.Enabled = true end)
    if hum.Health > 0 then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed) end) end
end

local function RestoreOriginalAnims()
    if AnimState.Original then ApplyAnims(AnimState.Original) end
end

