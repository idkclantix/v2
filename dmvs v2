-- Auto Equip de Silent Aim: sacar el arma al detectar enemigo y NO guardarla hasta que el jugador dispare.
task.spawn(function()
    while task.wait(AUTO_EQUIP_INTERVAL) do
        if destroyed then break end
        if not (silentAimEnabled and silentEquipEnabled) then continue end
        if legitMacroEnabled then continue end -- la macro maneja el arma por si sola
        if not IsInMatchStrict() then continue end
        if silentEquipBusy or equipBusy then continue end

        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local held = char:FindFirstChildOfClass("Tool")
        if silentEquipRespetarCuchillo and held and esCuchillo(held) then continue end
        if not (held and esPistola(held)) then
            if not autoEquipEnemyPartVisible() then continue end
            if not obtenerPistola() then continue end
            if not pcall(equipGunOnce) then continue end
            held = char:FindFirstChildOfClass("Tool")
            if not (held and esPistola(held)) then continue end
        end

        silentEquipBusy = true
        local holdTool = held
        task.spawn(function()
            local fired = false
            local conn = nil
            pcall(function()
                conn = holdTool.Activated:Connect(function() fired = true end)
            end)

            -- Sin timeout: el arma se queda afuera hasta que el usuario dispare.
            while task.wait(0.05) do
                if destroyed or not silentAimEnabled or not silentEquipEnabled then break end
                if fired then break end
                local c = player.Character
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if not c or not h or h.Health <= 0 then break end
                if c:FindFirstChildOfClass("Tool") ~= holdTool then break end
            end

            if conn then pcall(function() conn:Disconnect() end) end

            if silentEquipRespetarRecarga then
                local waitStart = os.clock()
                while os.clock() - waitStart < RELOAD_RESPECT_WAIT do
                    local gun = player.Character and player.Character:FindFirstChildOfClass("Tool")
                    if not gun or not estaRecargando(gun) then break end
                    task.wait(0.05)
                end
            end

            local cNow = player.Character
            local hNow = cNow and cNow:FindFirstChildOfClass("Humanoid")
            if hNow then pcall(function() hNow:UnequipTools() end) end
            task.wait(EQUIP_REEQUIP_DELAY)
            silentEquipBusy = false
        end)
    end
end)

