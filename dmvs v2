-- ============================================================
-- AIMBOT FUERTE (celular y PC)
-- Lock de camara directo al TORSO del enemigo en RenderStepped,
-- sin limite de FOV y con correccion casi instantanea. Tambien
-- fija XitadoHubTargetPart para que el disparo vaya al mismo punto.
-- ============================================================
aimbotState = { Enabled = false, Target = nil }
local AIMBOT_MAX_DIST = 2000
local AIMBOT_SNAP     = 0.75 -- 0..1: fuerza de correccion por frame (1 = snap total)
local AIMBOT_PREDICT  = 0.08
local aimbotRayParams = RaycastParams.new()
aimbotRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function aimbotVisible(from, part, myChar)
    if not part or not part.Parent then return false end
    local enemyChar = part:FindFirstAncestorOfClass("Model") or part.Parent
    aimbotRayParams.FilterDescendantsInstances = { myChar, enemyChar }
    local hit = workspace:Raycast(from, part.Position - from, aimbotRayParams)
    return not hit or (hit.Instance and hit.Instance:IsDescendantOf(enemyChar))
end

local function aimbotPickTarget()
    local myChar = player.Character
    local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    if not root or not cam then return nil end
    local head = myChar:FindFirstChild("Head") or root
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        -- si el enemigo no tiene ESP, el aimbot no lo cuenta
        if p ~= player and activeESPs[p] and esEnemigoValido(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local torso = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso")
                local headPart = p.Character:FindFirstChild("Head")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                for _, part in ipairs({ torso, headPart, hrp }) do
                    if part and part:IsA("BasePart") then
                        local dist = (part.Position - root.Position).Magnitude
                        if dist <= AIMBOT_MAX_DIST then
                            local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                            local screenDist = 500 -- penalidad si esta fuera de pantalla
                            if onScreen and sp.Z > 0 then
                                screenDist = (center - Vector2.new(sp.X, sp.Y)).Magnitude
                            end
                            -- prioridad torso, luego cercania al centro, luego distancia
                            local score = screenDist + dist * 0.05 - (part == torso and 250 or 0)
                            if score < bestScore and aimbotVisible(head.Position, part, myChar) then
                                bestScore = score
                                best = part
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

setAimbot = function(on)
    on = on == true
    if aimbotState.Enabled == on then return end
    aimbotState.Enabled = on
    if not on then
        aimbotState.Target = nil
        if getgenv then getgenv().XitadoHubTargetPart = nil end
    end
end

RunService.RenderStepped:Connect(function()
    if destroyed then return end
    local internalKill = autoKillState and autoKillState.Enabled
    if not aimbotState.Enabled and not internalKill then return end
    if estaEnLobby() then
        aimbotState.Target = nil
        return
    end
    -- Gun Only / Knife Only aplican al Aimbot del hub (el interno de Auto Kill no)
    if aimbotState.Enabled then
        local myChar = player.Character
        local tool = myChar and myChar:FindFirstChildOfClass("Tool")
        if aimbotGunOnly and aimbotKnifeOnly then
            if not tool or not (esPistola(tool) or esCuchillo(tool)) then aimbotState.Target = nil; return end
        elseif aimbotGunOnly then
            if not tool or not esPistola(tool) then aimbotState.Target = nil; return end
        elseif aimbotKnifeOnly then
            if not tool or not esCuchillo(tool) then aimbotState.Target = nil; return end
        end
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local target = nil
    if internalKill then
        -- Aimbot interno: SOLO el enemigo del teletransporte, y solo si tiene ESP.
        local killTarget = autoKillState.Target
        if killTarget and killTarget.Character and activeESPs[killTarget] then
            local kc = killTarget.Character
            target = kc:FindFirstChild("UpperTorso") or kc:FindFirstChild("Torso")
                or kc:FindFirstChild("Head") or kc:FindFirstChild("HumanoidRootPart")
        end
        if not target then return end
    else
        -- Aimbot del toggle: SOLO enemigos con ESP y con linea de vision despejada.
        -- Se revalida cada frame; si se tapa, muere o pierde ESP, se suelta y busca otro.
        target = aimbotState.Target
        local sigueValido = false
        if target and target.Parent and target:IsA("BasePart") then
            local tChar = target:FindFirstAncestorOfClass("Model")
            local tPlayer = tChar and Players:GetPlayerFromCharacter(tChar)
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            local myCharNow = player.Character
            local desde = myCharNow and (myCharNow:FindFirstChild("Head") or myCharNow:FindFirstChild("HumanoidRootPart"))
            if tPlayer and tPlayer ~= player and activeESPs[tPlayer] and esEnemigoValido(tPlayer)
                and tHum and tHum.Health > 0 and desde then
                sigueValido = aimbotVisible(desde.Position, target, myCharNow)
            end
        end
        if not sigueValido then
            target = aimbotPickTarget()
            aimbotState.Target = target
        end
        if not target then return end
    end
    local vel = target.AssemblyLinearVelocity
    if vel.Magnitude > 150 then vel = vel.Unit * 150 end
    local predicted = target.Position + vel * AIMBOT_PREDICT
    local targetCF = CFrame.lookAt(cam.CFrame.Position, predicted)
    pcall(function()
        cam.CFrame = cam.CFrame:Lerp(targetCF, AIMBOT_SNAP)
    end)
    if getgenv then getgenv().XitadoHubTargetPart = target end
end)

