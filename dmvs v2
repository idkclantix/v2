-- AutoShot agresivo de 01rox: barre todas las partes visibles (menos HumanoidRootPart).
task.spawn(function()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    while task.wait(0.1) do
        if destroyed then break end
        if macroBusy then continue end -- no pisar el objetivo elegido por la macro
        if not autoShootEnabled or estaEnLobby() then
            if not silentAimEnabled then getgenv().XitadoHubTargetPart = nil end
            continue
        end
        if shootBusy then continue end
        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool or not tool:FindFirstChild("Handle") or esCuchillo(tool) then
            getgenv().XitadoHubTargetPart = nil
            continue
        end
        local head = char:FindFirstChild("Head")
        local headPos = head and head.Position or root.Position
        local myPos = root.Position
        local closestPart, shortestDist = nil, math.huge
        local closestTorso, torsoDist = nil, math.huge -- prioridad: disparar al torso si esta visible
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and esEnemigoValido(p) and p.Character then
                local enemyHum = p.Character:FindFirstChildOfClass("Humanoid")
                if enemyHum and enemyHum.Health > 0 then
                    params.FilterDescendantsInstances = { char, p.Character }
                    for _, part in ipairs(p.Character:GetChildren()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            local dist = (part.Position - myPos).Magnitude
                            local isTorso = part.Name == "UpperTorso" or part.Name == "Torso"
                            if isTorso then
                                if dist >= torsoDist then continue end
                            elseif dist >= shortestDist then
                                continue
                            end
                            local size = part.Size
                            local offsets = { Vector3.zero, Vector3.new(0, size.Y / 2.1, 0), Vector3.new(0, -size.Y / 2.1, 0) }
                            for _, off in ipairs(offsets) do
                                if not workspace:Raycast(headPos, (part.CFrame * off) - headPos, params) then
                                    if isTorso then
                                        torsoDist = dist
                                        closestTorso = part
                                    else
                                        shortestDist = dist
                                        closestPart = part
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
        closestPart = closestTorso or closestPart -- torso tiene prioridad sobre cualquier otra parte
        if not closestPart then
            if not silentAimEnabled then getgenv().XitadoHubTargetPart = nil end
            continue
        end
        if os.clock() - lastShootTime < SHOOT_COOLDOWN then continue end
        shootBusy = true
        getgenv().XitadoHubTargetPart = closestPart
        lastShootTime = os.clock()
        pcall(function()
            tool:Activate()
            task.delay(0.05, function()
                if tool.Parent == char then tool:Deactivate() end
            end)
        end)
        task.wait(0.2)
        shootBusy = false
    end
end)

