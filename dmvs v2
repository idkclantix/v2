end })

local animRemove = { Enabled = false, Conns = {}, Stopped = setmetatable({},{__mode="k"}) }

local function stopAllAnimsOnChar(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if not animRemove.Stopped[track] then
            pcall(function() track:Stop(0) end)
            animRemove.Stopped[track] = true
        end
    end
    -- also zero walk/move speed contribution from default animations
    pcall(function() hum.WalkSpeed = hum.WalkSpeed end) -- force humanoid re-eval
end

local function startAnimRemove()
    -- stop anims on all existing chars
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            task.spawn(stopAllAnimsOnChar, plr.Character)
        end
        local c = plr.CharacterAdded:Connect(function(char)
            task.wait(0.3)
            if animRemove.Enabled then stopAllAnimsOnChar(char) end
        end)
        table.insert(animRemove.Conns, c)
    end
    
    local hbConn = RunService.Heartbeat:Connect(function()
        if not animRemove.Enabled then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr.Character
            if not char then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            if not animator then continue end
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if not animRemove.Stopped[track] then
                    pcall(function() track:Stop(0) end)
                    animRemove.Stopped[track] = true
                end
            end
        end
    end)
    table.insert(animRemove.Conns, hbConn)
    local added = Players.PlayerAdded:Connect(function(plr)
        local c = plr.CharacterAdded:Connect(function(char)
            task.wait(0.3)
            if animRemove.Enabled then stopAllAnimsOnChar(char) end
        end)
        table.insert(animRemove.Conns, c)
    end)
    table.insert(animRemove.Conns, added)
end

local function stopAnimRemove()
    for _, c in ipairs(animRemove.Conns) do pcall(function() c:Disconnect() end) end
    table.clear(animRemove.Conns)
    table.clear(animRemove.Stopped)
end

