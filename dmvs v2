local function modShiftEffectRoot(root, deathCF)
    local delta = deathCF
    local origin = nil
    pcall(function() origin = root:GetAttribute("DMVS_EffectOrigin") end)
    if typeof(origin) == "CFrame" then delta = deathCF * origin:Inverse() end
    local function shift(obj)
        if obj:IsA("BasePart") then
            pcall(function() obj.CFrame = delta * obj.CFrame end)
        end
    end
    shift(root)
    for _, obj in ipairs(root:GetDescendants()) do shift(obj) end
end

local function modPlayHeavyFX(info, deathCF, anchor)
    local name = info.Asset or info.Name
    local builder = modEffectBuilders[name]
    if type(builder) ~= "function" then return false end
    local template = modFXTemplateCache[name]
    if template == nil then
        local okBuild, root = pcall(builder)
        if not okBuild or not root then return false end
        template = root
        modFXTemplateCache[name] = root
    end
    local okClone, root = pcall(function() return template:Clone() end)
    if not okClone or not root then return false end
    pcall(function() modShiftEffectRoot(root, deathCF) end)
    root.Parent = anchor

    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("ParticleEmitter") then
            local count = math.floor(tonumber(obj:GetAttribute("EmitCount")) or 0)
            local delay = math.max(0, tonumber(obj:GetAttribute("EmitDelay")) or 0)
            local duration = math.max(0, tonumber(obj:GetAttribute("EmitDuration")) or 0)
            task.delay(delay, function()
                if destroyed or not root.Parent then return end
                pcall(function()
                    if count > 0 then
                        obj:Emit(count)
                    else
                        obj.Enabled = true
                        if duration > 0 then
                            task.delay(duration, function()
                                if obj.Parent then obj.Enabled = false end
                            end)
                        end
                    end
                end)
            end)
        end
    end

    local animators, animations = {}, {}
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("Animator") then
            animators[#animators + 1] = obj
        elseif obj:IsA("Animation") then
            animations[#animations + 1] = obj
        end
    end
    if #animators == 0 then
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("AnimationController") then
                local animator = obj:FindFirstChildOfClass("Animator")
                if not animator then
                    animator = Instance.new("Animator")
                    animator.Parent = obj
                end
                animators[#animators + 1] = animator
            end
        end
    end
    if #animators > 0 and #animations > 0 then
        for _, anim in ipairs(animations) do
            pcall(function()
                local track = animators[1]:LoadAnimation(anim)
                track.Priority = Enum.AnimationPriority.Action
                track:Play()
            end)
        end
    end
    return true
end

