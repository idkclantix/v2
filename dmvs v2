-- Cambio de nombre portado de clanxitado: reescribe los textos de la UI del juego
-- (PlayerGui / CoreGui / Workspace). No modifica DisplayName de Humanoid.
-- ============================================================
local function setupNameChanger()
    local N = {
        Enabled = false, ForAll = false, CustomName = "xitado",
        Connections = {}, ContainerConnections = {},
        Tracked = setmetatable({}, { __mode = "k" }),
        Original = setmetatable({}, { __mode = "k" }),
        Rendered = setmetatable({}, { __mode = "k" }),
        Updating = setmetatable({}, { __mode = "k" }),
    }

    local function escapeNamePattern(text)
        return string.gsub(text, "([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")
    end
    local function isNameTextElement(element)
        return element:IsA("TextLabel") or element:IsA("TextButton") or element:IsA("TextBox")
    end
    local function transformNameText(text)
        if not N.Enabled or not N.CustomName or N.CustomName == "" then return text end
        local out = text
        if N.ForAll then
            for _, target in ipairs(Players:GetPlayers()) do
                if target.Name and target.Name ~= "" then
                    out = string.gsub(out, escapeNamePattern(target.Name), N.CustomName)
                end
                if target.DisplayName and target.DisplayName ~= "" and target.DisplayName ~= target.Name then
                    out = string.gsub(out, escapeNamePattern(target.DisplayName), N.CustomName)
                end
            end
        else
            if player.Name and player.Name ~= "" then
                out = string.gsub(out, escapeNamePattern(player.Name), N.CustomName)
            end
            if player.DisplayName and player.DisplayName ~= "" and player.DisplayName ~= player.Name then
                out = string.gsub(out, escapeNamePattern(player.DisplayName), N.CustomName)
            end
        end
        return out
    end
    local function refreshNameElement(element)
        if not element or not element.Parent or not isNameTextElement(element) or N.Updating[element] then return end
        local current = element.Text
        local original = N.Original[element]
        local rendered = N.Rendered[element]
        if original == nil then
            original = current
        elseif rendered ~= nil and current ~= rendered then
            original = current
        end
        N.Original[element] = original
        local result = transformNameText(original)
        N.Rendered[element] = result
        if element.Text ~= result then
            N.Updating[element] = true
            pcall(function() element.Text = result end)
            N.Updating[element] = nil
        end
    end
    function N.Refresh()
        for element in pairs(N.Tracked) do refreshNameElement(element) end
    end
    local function trackNameElement(element)
        if not element or not element.Parent or not isNameTextElement(element) then return end
        N.Tracked[element] = true
        if not N.Connections[element] then
            N.Connections[element] = element:GetPropertyChangedSignal("Text"):Connect(function()
                refreshNameElement(element)
            end)
        end
        refreshNameElement(element)
    end
    local function scanNameContainer(container)
        if not container or N.ContainerConnections[container] then return end
        for _, element in ipairs(container:GetDescendants()) do trackNameElement(element) end
        N.ContainerConnections[container] = container.DescendantAdded:Connect(trackNameElement)
    end
    function N.SetEnabled(v) N.Enabled = v == true; N.Refresh() end
    function N.SetForAll(v) N.ForAll = v == true; N.Refresh() end
    function N.SetCustomName(v) N.CustomName = tostring(v or ""); N.Refresh() end
    function N.Start()
        task.spawn(function()
            local containers = { player:WaitForChild("PlayerGui"), CoreGui }
            for _, container in ipairs(containers) do
                pcall(function() scanNameContainer(container) end)
                task.wait()
            end
            -- Workspace puede tener miles de objetos: se escanea aparte y mas tarde
            task.wait(1)
            pcall(function() scanNameContainer(Workspace) end)
        end)
    end
    function N.Stop()
        N.Enabled = false
        for element, conn in pairs(N.Connections) do pcall(function() conn:Disconnect() end); N.Connections[element] = nil end
        for container, conn in pairs(N.ContainerConnections) do pcall(function() conn:Disconnect() end); N.ContainerConnections[container] = nil end
        table.clear(N.Tracked); table.clear(N.Original); table.clear(N.Rendered); table.clear(N.Updating)
    end
    return N
end

local NameChanger = setupNameChanger()
