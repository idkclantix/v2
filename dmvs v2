local TRIGGER_DELAY = 0.02; local TRIGGER_SHOOT = 0.05; local TRIGGER_COOLDOWN = 0.18
local TRIGGER_MIN_VISIBLE_POINTS = 2; local TriggerEnabled = false
local triggerRayParams = RaycastParams.new(); triggerRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function triggerTargetClearlyVisible(character)
    local cam = Workspace.CurrentCamera; local myCharacter = player.Character
    if not cam or not character or not myCharacter then return false end
    local samples = { character:FindFirstChild("Head"), character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"), character:FindFirstChild("HumanoidRootPart") }
    triggerRayParams.FilterDescendantsInstances = {myCharacter, character}
    local visiblePoints = 0
    for _, part in ipairs(samples) do
        if part and part:IsA("BasePart") then
            local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen and screenPos.Z > 0 then
                local origin = cam.CFrame.Position; local direction = part.Position - origin
                local obstruction = Workspace:Raycast(origin, direction, triggerRayParams)
                if not obstruction then visiblePoints += 1; if visiblePoints >= TRIGGER_MIN_VISIBLE_POINTS then return true end end
            end
