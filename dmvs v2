local function onHubDestroy()
    destroyed = true

    autoShootEnabled = false
    autoEquipEnabled = false
    silentAimEnabled = false
    silentEquipEnabled = false
    if getgenv then getgenv().XitadoHubTargetPart = nil end
    pcall(limpiarAgresivoHitboxes)
    pcall(clearGhostHitboxes)
    pcall(function()
        hitboxState.Enabled = false
        legitTriggerEnabled = false
        legitMacroEnabled = false
        aimbotGunOnly = false
        aimbotKnifeOnly = false
        for _, c in ipairs(legitConns) do pcall(function() c:Disconnect() end) end
        table.clear(legitConns)
        table.clear(macroTouch.Active)
        table.clear(macroTouch.StartPos)
        table.clear(macroTouch.WasDrag)
        table.clear(macroTouch.StartTime)
    end)
    pcall(function()
        if FarmCtl then FarmCtl.Stop() end
        if autoEventFarm then autoEventFarm.Remote = nil end
    end)

    if espConnection then pcall(function() espConnection:Disconnect() end); espConnection = nil end
    if espRemoveConn then pcall(function() espRemoveConn:Disconnect() end); espRemoveConn = nil end
    for p in pairs(activeESPs) do cleanESP(p) end
    if espFolder then pcall(function() espFolder:Destroy() end); espFolder = nil end

    pcall(function() setAura(false) end)
    pcall(function() setFly(false) end)
    pcall(function() setAutoKill(false) end)
    pcall(function() if setAimbot then setAimbot(false) end end)
    pcall(function() setInvisible(false) end)
    pcall(stopBajarMonitor)
    pcall(function() if bajarState.Enabled then doSubir() end end)
    pcall(CleanupButtons)

    pcall(Mod.StopWalk)
    pcall(function()
        Mod.KillSound.Enabled = false
        Mod.KillFX.Enabled = false
        Mod.SetKillSoundMute(false)
    end)
    pcall(Mod.StopKillDetection)
    pcall(Mod.StopShootWatchers)
    for _, conns in ipairs({ Mod.DeathSoundConns, Mod.RemoteConns, Mod.StatConns }) do
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
    end
    pcall(function()
        if Mod.KillFX.Folder then Mod.KillFX.Folder:Destroy(); Mod.KillFX.Folder = nil end
        table.clear(Mod.FXTemplateCache)
        table.clear(Mod.EffectBuilders)
    end)
    pcall(function() Mod.Streak.Cleanup() end)
    pcall(function() Mod.Cursor.Remove() end)
    pcall(function() Mod.Wand.Disable() end)
    pcall(function()
        for _, root in ipairs({ CoreGui }) do
            for _, c in ipairs(root:GetChildren()) do
                if c.Name == "XitadoAuraNotify" then c:Destroy() end
            end
        end
        if gethui then local h = gethui(); if h then for _, c in ipairs(h:GetChildren()) do if c.Name == "XitadoAuraNotify" then c:Destroy() end end end end
    end)
    pcall(function() NameChanger.Stop() end)
    pcall(function() Mod.KillSoundPlayer:Destroy(); Mod.ShootSoundPlayer:Destroy() end)

    pcall(function() if accessoryRemove.Enabled then stopAccessoryRemove() end end)
    pcall(function() if animRemove.Enabled then stopAnimRemove() end end)
    pcall(function() setLowGraphics(false) end)
    pcall(function() restoreSky() end)
    pcall(function() if perfHUD.Conn then perfHUD.Conn:Disconnect(); perfHUD.Conn = nil end end)
    pcall(function() if perfHUD.Gui then perfHUD.Gui:Destroy(); perfHUD.Gui = nil end end)
    pcall(function()
        if AnimState.Selected then RestoreOriginalAnims() end
        AnimState.Selected = nil; AnimState.SelectedName = nil
    end)

    if oldNamecallHook and hookmetamethod then
        pcall(function() hookmetamethod(game, "__namecall", oldNamecallHook) end)
        oldNamecallHook = nil
    end

    if getgenv then getgenv().XitadoWindow = nil end
end

if getgenv then getgenv().XitadoHubCleanup = onHubDestroy end
