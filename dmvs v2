local function PlayShootSound()
    if not shootSound.Enabled then return end
    local cfg = ShootReloadOptions[shootSound.Selected]
    if not cfg or not cfg.Shoot then return end
    local now = tick()
    if now - lastShootSoundTime < SHOOT_SOUND_MIN_INTERVAL then return end
    lastShootSoundTime = now
    shootSoundToken = shootSoundToken + 1
    local myToken = shootSoundToken
    ShootSoundPlayer:Stop()
    ShootSoundPlayer.SoundId = "rbxassetid://"..cfg.Shoot
    ShootSoundPlayer.Volume = shootSound.Volume or 2.5
    ShootSoundPlayer:Play()
    task.delay(SHOOT_SOUND_MAX_DURATION, function()
        if shootSoundToken == myToken and ShootSoundPlayer.Playing then ShootSoundPlayer:Stop() end
    end)
end

local function HookFireSound(s)
    if not s:IsA("Sound") then return end
    if not isFireSound(s) then return end
    if xitadosFireWatched[s] then return end
    xitadosFireWatched[s] = true
    local function applyMuteState()
        if shootSound.Enabled then
            if s:GetAttribute("XitadoOrigVol") == nil then s:SetAttribute("XitadoOrigVol", s.Volume) end
            pcall(function() s.Volume = 0 end)
        else
            local orig = s:GetAttribute("XitadoOrigVol")
            if orig ~= nil then pcall(function() s.Volume = orig end); s:SetAttribute("XitadoOrigVol", nil) end
        end
    end
    applyMuteState()
    xitadosTrackShoot(s.Played:Connect(function()
        local char = player.Character
        if not char then return end
        local backpack = player:FindFirstChildOfClass("Backpack")
        if s:IsDescendantOf(char) or (backpack and s:IsDescendantOf(backpack)) then
            if shootSound.Enabled then pcall(function() s.Volume = 0 end); PlayShootSound() end
        end
    end))
    xitadosTrackShoot(RunService.Heartbeat:Connect(function()
        if shootSound.Enabled then
            if s:GetAttribute("XitadoOrigVol") == nil and s.Volume > 0 then
                s:SetAttribute("XitadoOrigVol", s.Volume); pcall(function() s.Volume = 0 end)
            end
        else
            local orig = s:GetAttribute("XitadoOrigVol")
            if orig ~= nil then pcall(function() s.Volume = orig end); s:SetAttribute("XitadoOrigVol", nil) end
        end
    end))
end

local function HookShootOnTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    for _, d in ipairs(tool:GetDescendants()) do HookFireSound(d) end
    if not xitadosToolWatched[tool] and shootSound.Enabled then
        xitadosToolWatched[tool] = true
        xitadosTrackShoot(tool.DescendantAdded:Connect(HookFireSound))
    end
end

local function HookShootOnRoot(root)
    if not root then return end
    for _, child in ipairs(root:GetChildren()) do if child:IsA("Tool") then HookShootOnTool(child) end end
    xitadosTrackShoot(root.ChildAdded:Connect(function(child) if child:IsA("Tool") then HookShootOnTool(child) end end))
end

