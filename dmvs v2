local function getCenter()
    local cam = Workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(0,0)
    return Vector2.new(vp.X/2, vp.Y/2)
end

local function getBestTarget(partName, fovSize)
    local myChar = player.Character; if not myChar then return nil,nil end
    local myHum  = myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myHum or myHum.Health <= 0 or not myRoot then return nil,nil end
    local cam = Workspace.CurrentCamera; if not cam then return nil,nil end
    local bestPart, bestPoint, bestDist = nil, nil, fovSize
    local center = getCenter()
    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) then
            local char = plr.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = resolvePart(char, partName)
                if part then
                    local point = part.Position
                    local pos, onScreen = cam:WorldToViewportPoint(point)
                    if onScreen and pos.Z > 0 then
                        local metric = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if metric <= fovSize and metric < bestDist and hasLineOfSight(part) then
                            bestDist = metric; bestPart = part; bestPoint = point
                        end
                    end
                end
            end
        end
    end
    return bestPart, bestPoint
end

local GRMT = typeof(getrawmetatable)=="function" and getrawmetatable or nil
local SRO  = typeof(setreadonly)    =="function" and setreadonly     or nil
local CC   = typeof(checkcaller)    =="function" and checkcaller     or nil
local SilentIsDead = false
local silentHook = { CacheAt = 0, CachePart = nil, CachePos = nil }
silentHook.Samples = setmetatable({}, {__mode="k"})

RunService.Heartbeat:Connect(function()
    if destroyed or not silentAim.Enabled then return end
    local now = os.clock()
    for _, plr in ipairs(Players:GetPlayers()) do
        local character = plr ~= player and plr.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            local pos = root.Position
            local sample = silentHook.Samples[root]
            if not sample then
                silentHook.Samples[root] = { pos=pos, t=now, vel=Vector3.zero }
            elseif pos ~= sample.pos then
                local dt = now - sample.t
                local raw = dt > 0 and (pos - sample.pos)/dt or Vector3.zero
                sample.vel = raw.Magnitude > 150 and Vector3.zero or sample.vel:Lerp(raw, 0.6)
                sample.pos, sample.t = pos, now
            elseif now - sample.t > 0.15 then
                sample.vel = Vector3.zero
            end
        end
    end
end)

function silentHook.Velocity(root)
    local sample = silentHook.Samples[root]
    local measured = sample and sample.vel or Vector3.zero
    local reported = root.AssemblyLinearVelocity
    return measured.Magnitude > reported.Magnitude and measured or reported
end

function silentHook.Pick()
    local now = os.clock()
    if now - silentHook.CacheAt < 0.016 then return silentHook.CachePart, silentHook.CachePos end
    local part, pos = nil, nil
    if not SilentIsDead then
        if silentAim.Enabled then
            local p, point = getBestTarget(silentAim.TargetPart, silentAim.FOVSize)
            if p and point then
                part, pos = p, point
                if silentAim.Prediction > 0 then
                    local root = p.Parent and p.Parent:FindFirstChild("HumanoidRootPart")
                    if root then pos = pos + silentHook.Velocity(root) * silentAim.Prediction end
                end
            end
        end
        if not part and autoShoot.Enabled then
            local p, point = getBestTarget(autoShoot.TargetPart, autoShoot.FOVSize)
            if p and point then part, pos = p, point end
        end
    end
    silentHook.CacheAt, silentHook.CachePart, silentHook.CachePos = now, part, pos
    return part, pos
end

local function installMouseHook()
    if not (GRMT and SRO) then return false end
    local ok = pcall(function()
        local mt = GRMT(mouse)
        if not mt or type(mt.__index) ~= "function" then error("no func") end
        local oldIndex = mt.__index
        SRO(mt, false)
        mt.__index = function(self, key)
            if CC and CC() then return oldIndex(self, key) end
            if self == mouse and key == "Hit" then
                local p, pos = silentHook.Pick()
                if p then return CFrame.new(pos) end
            end
            return oldIndex(self, key)
        end
        SRO(mt, true)
    end)
    return ok
