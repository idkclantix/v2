function Feat.Set(name, v)
    local f=Feat[name]; if type(f)~="table" then return end
    v=v==true; if f.get()==v then return end; f.set(v)
    local actual=f.get()==true
    if f.handle then pcall(function() f.handle:Set(actual, true) end) end
    Extras.RefreshButtons()
end
function Feat.Toggle(name) local f=Feat[name]; if type(f)=="table" then Feat.Set(name, not f.get()) end end

