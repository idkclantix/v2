--  BORRAR ACCESORIOS
-- ═══════════════════════════════════════════════════════════════
local accessoryRemove = { Enabled = false, Cache = {}, Conns = {} }

local function removeAccessoriesFromChar(char)
    if not char then return end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Hat") then
            if not accessoryRemove.Cache[obj] then
                accessoryRemove.Cache[obj] = obj.Parent
                obj.Parent = nil
            end
        end
    end
end

local function restoreAccessories()
    for obj, parent in pairs(accessoryRemove.Cache) do
        pcall(function()
            if obj and obj.Parent == nil and parent and parent.Parent then
                obj.Parent = parent
            end
        end)
    end
    table.clear(accessoryRemove.Cache)
end

local function startAccessoryRemove()
    -- remove from all current chars
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then removeAccessoriesFromChar(plr.Character) end
        local c = plr.CharacterAdded:Connect(function(char)
            task.wait(0.1)
            if accessoryRemove.Enabled then removeAccessoriesFromChar(char) end
        end)
        table.insert(accessoryRemove.Conns, c)
    end
    local added = Players.PlayerAdded:Connect(function(plr)
        local c = plr.CharacterAdded:Connect(function(char)
            task.wait(0.1)
            if accessoryRemove.Enabled then removeAccessoriesFromChar(char) end
        end)
        table.insert(accessoryRemove.Conns, c)
    end)
    table.insert(accessoryRemove.Conns, added)
end

local function stopAccessoryRemove()
    for _, c in ipairs(accessoryRemove.Conns) do pcall(function() c:Disconnect() end) end
    table.clear(accessoryRemove.Conns)
    restoreAccessories()
end

