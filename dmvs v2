local SILENT_BULLET_SPEED = 99999
local SILENT_MAX_LEAD_VEL = 0
local SILENT_MIN_DIR      = 20 -- 01rox: solo redirige disparos reales, no raycasts de camara

local function predictSilentAimPosition(origin, target)
    if not target or not target.Parent then return origin end
    local pos = target.Position
    local vel = target.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed > SILENT_MAX_LEAD_VEL then
        vel = vel.Unit * SILENT_MAX_LEAD_VEL
    elseif speed < 1.25 then
        return pos
    end
    local distance = (pos - origin).Magnitude
    local travelTime = distance / SILENT_BULLET_SPEED
    return pos + vel * travelTime
end

local function silentGetAimParts(character)
    local parts = {}
    if not character then return parts end
    if silentAimTargetPart == "Head" then
        local head = character:FindFirstChild("Head")
        if head and head:IsA("BasePart") then parts[1] = head end
    elseif silentAimTargetPart == "Torso" then
        for _, name in ipairs({ "UpperTorso", "Torso", "HumanoidRootPart" }) do
            local p = character:FindFirstChild(name)
            if p and p:IsA("BasePart") then parts[#parts + 1] = p end
        end
    else
        for _, p in ipairs(character:GetChildren()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then parts[#parts + 1] = p end
        end
        if #parts == 0 then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then parts[1] = hrp end
        end
    end
    return parts
end

local function silentPartVisible(fromPos, part, myChar, enemyChar, params)
    if not part then return false end
    params.FilterDescendantsInstances = { myChar, enemyChar }
    local hit = workspace:Raycast(fromPos, part.Position - fromPos, params)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(enemyChar)
end

local function findSilentTarget()
    local char = player.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    local myHead = char:FindFirstChild("Head")
    if not myRoot then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local fromPos = myHead and myHead.Position or myRoot.Position
    local mousePos = UserInputService:GetMouseLocation()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local bestPart, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and esEnemigoValido(p) then
            local eChar = p.Character
            if eChar then
                local parts = silentGetAimParts(eChar)
                for i = 1, #parts do
                    local part = parts[i]
                    local pos2d, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen and pos2d.Z > 0 then
                        local screenDist = (mousePos - Vector2.new(pos2d.X, pos2d.Y)).Magnitude
                        if silentPartVisible(fromPos, part, char, eChar, params) then
                            local worldDist = (part.Position - fromPos).Magnitude
                            local score = screenDist + worldDist * 0.02
                            if score < bestScore then bestScore = score; bestPart = part end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

oldNamecallHook = nil
if hookmetamethod and getnamecallmethod and checkcaller then
    oldNamecallHook = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if auraEnabled and not checkcaller() and method == "FireServer" then
            local first = ...
            if first == AURA_ARG then auraRemote = self end
        end
        if not checkcaller() and getgenv().XitadoHubTargetPart then
            local target = getgenv().XitadoHubTargetPart
            local camNow = workspace.CurrentCamera
            local cameraOrigin = camNow and camNow.CFrame.Position
            if not (target and target.Parent) then
                getgenv().XitadoHubTargetPart = nil
                return oldNamecallHook(self, ...)
            end
            if method == "Raycast" and self == workspace then
                local origin, direction, p3 = ...
                if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and direction.Magnitude > SILENT_MIN_DIR
                    and cameraOrigin and (origin - cameraOrigin).Magnitude >= 1 then
                    local predicted = predictSilentAimPosition(origin, target)
                    local newDir = (predicted - origin)
                    if newDir.Magnitude > 0.001 then
                        newDir = newDir.Unit * 5000
                        return oldNamecallHook(self, origin, newDir, p3)
                    end
                end
            elseif self == workspace and typeof(method) == "string" and method:sub(1, 13) == "FindPartOnRay" then
                local ray, p2, p3, p4 = ...
                if typeof(ray) == "Ray" and ray.Direction.Magnitude > SILENT_MIN_DIR
                    and cameraOrigin and (ray.Origin - cameraOrigin).Magnitude >= 1 then
                    local predicted = predictSilentAimPosition(ray.Origin, target)
                    local newDir = (predicted - ray.Origin)
                    if newDir.Magnitude > 0.001 then
                        newDir = newDir.Unit * 5000
                        local newRay = Ray.new(ray.Origin, newDir)
                        return oldNamecallHook(self, newRay, p2, p3, p4)
                    end
                end
            end
        end
        return oldNamecallHook(self, ...)
    end)
else
    warn("[Xitado Hub] Hook de raycast no disponible en este entorno.")
end

