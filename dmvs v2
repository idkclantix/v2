                task.wait(TRIGGER_DELAY)
                if not TriggerEnabled then continue end
                myCharacter = player.Character; tool = myCharacter and myCharacter:FindFirstChildOfClass("Tool")
                if not (tool and isGun(tool)) then continue end
                if not character.Parent or humanoid.Health <= 0 or not triggerTargetClearlyVisible(character) then continue end
