    local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y, 0)
    triggerRayParams.FilterDescendantsInstances = { player.Character }
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 900, triggerRayParams)
    return hit and hit.Instance or nil
