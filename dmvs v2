local function attachSnowflakes()
    local mainFrame
    for _ = 1, 50 do
        mainFrame = Window.UIElements and Window.UIElements.Main and Window.UIElements.Main.Main
        if mainFrame then break end
        task.wait(0.1)
    end
    if not mainFrame then return end

    local snowLayer = Instance.new("Frame")
    snowLayer.Name                 = "SnowLayer"
    snowLayer.BackgroundTransparency = 1
    snowLayer.Size                 = UDim2.fromScale(1, 1)
    snowLayer.ClipsDescendants     = true
    snowLayer.ZIndex               = 2
    snowLayer.Parent               = mainFrame

    local flakes = {}
    for _ = 1, 30 do
        local f = Instance.new("Frame")
        f.Size                 = UDim2.fromOffset(math.random(2, 5), math.random(2, 5))
        f.BackgroundColor3     = Color3.fromRGB(255, 255, 255)
        f.BorderSizePixel      = 0
        f.BackgroundTransparency = math.random(20, 60) / 100
        f.Position             = UDim2.new(math.random(), 0, -0.05, 0)
        f.ZIndex               = 2
        f.Parent               = snowLayer
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        table.insert(flakes, {
            Frame    = f,
            Speed    = math.random(30, 110) / 1000,
            Drift    = math.random(-60, 60) / 1000,
            RotSpeed = math.random(-250, 250) / 100,
            Phase    = math.random() * math.pi * 2,
        })
    end

    local flakeAcc = 0
    RunService.RenderStepped:Connect(function(dt)
        if destroyed or not mainFrame or not mainFrame.Parent then return end
        flakeAcc = flakeAcc + dt
        if flakeAcc < 0.033 then return end -- ~30 fps en vez de 60 para no cargar el render
        local step = flakeAcc
        flakeAcc = 0
        for _, s in ipairs(flakes) do
            local f = s.Frame
            if not f or not f.Parent then continue end
            s.Phase = s.Phase + step
            local ny = f.Position.Y.Scale + s.Speed * step
            local nx = f.Position.X.Scale + (s.Drift + math.sin(s.Phase) * 0.02) * step
            if ny > 1.05 then ny = -0.05; nx = math.random() end
            f.Position = UDim2.new(nx, 0, ny, 0)
            f.Rotation = f.Rotation + s.RotSpeed * step * 60
        end
    end)
end
task.spawn(attachSnowflakes)

end

