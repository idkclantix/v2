-- Invisibilidad en su propio scope (libera registers del chunk principal)
local function setupInvisibility()

invisState = {
    Enabled = false, Conn = nil, Char = nil, Hum = nil, Root = nil, Parts = {},
    Clone = nil, CloneRoot = nil, OrigPos = nil, OrigAutoRotate = nil, OrigPlatformStand = nil,
    OrigJumpHeight = nil, OrigJumpPower = nil, LastGroundPos = nil, WalkSpeed = 16,
    GroupConns = {}, FallVelocity = 0, LastScan = 0, LastPassScan = 0, LastMirror = 0,
    MirrorParams = nil, GroundOffset = nil, SmoothY = nil,
}
local invisPassChanged = setmetatable({}, { __mode = "k" })
local INVIS_ALTITUDE = 25000
local GROUP_INVISIBLE, GROUP_OTHERS = "XitadoInvisible", "XitadoOthers"
local groupsReady = false

local function setupInvisGroups()
    if groupsReady then return end
    pcall(function() PhysicsService:RegisterCollisionGroup(GROUP_INVISIBLE) end)
    pcall(function() PhysicsService:RegisterCollisionGroup(GROUP_OTHERS) end)
    pcall(function() PhysicsService:CollisionGroupSetCollidable(GROUP_INVISIBLE, GROUP_OTHERS, false) end)
    groupsReady = true
end
local function assignInvisGroup(char, group)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then pcall(function() PhysicsService:SetPartCollisionGroup(part, group) end) end
    end
    table.insert(invisState.GroupConns, char.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") then pcall(function() PhysicsService:SetPartCollisionGroup(obj, group) end) end
    end))
end
local function resetInvisGroup(char)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then pcall(function() PhysicsService:SetPartCollisionGroup(part, "Default") end) end
    end
end
local function clearInvisGroupConns()
    for _, c in ipairs(invisState.GroupConns) do pcall(function() c:Disconnect() end) end
    table.clear(invisState.GroupConns)
end
local function setOthersPassThrough(active)
    if active then
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr ~= player and plr.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        invisPassChanged[part] = true
                        pcall(function() part.CanCollide = false end)
                    end
                end
            end
        end
    else
        for part in pairs(invisPassChanged) do
            invisPassChanged[part] = nil
            if part and part.Parent then pcall(function() part.CanCollide = true end) end
        end
    end
end
local function tagOtherPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then assignInvisGroup(p.Character, GROUP_OTHERS) end
        table.insert(invisState.GroupConns, p.CharacterAdded:Connect(function(char)
            if p ~= player then task.wait(0.1); assignInvisGroup(char, GROUP_OTHERS) end
        end))
    end
    table.insert(invisState.GroupConns, Players.PlayerAdded:Connect(function(p)
        if p == player then return end
        table.insert(invisState.GroupConns, p.CharacterAdded:Connect(function(char)
            task.wait(0.1); assignInvisGroup(char, GROUP_OTHERS)
        end))
    end))
end
local function updateInvisRefs()
    local s = invisState
    s.Char = player.Character
    if not s.Char then return end
    s.Hum = s.Char:FindFirstChildOfClass("Humanoid")
    s.Root = s.Char:FindFirstChild("HumanoidRootPart")
    s.Parts = {}
    for _, part in ipairs(s.Char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then table.insert(s.Parts, part) end
    end
end
local function applyInvisTransparency(state)
    for _, part in ipairs(invisState.Parts) do
        if part and part.Parent then pcall(function() part.Transparency = state and 0.5 or 0 end) end
    end
end
local function destroyInvisClone()
    if invisState.Clone then pcall(function() invisState.Clone:Destroy() end) end
    invisState.Clone = nil; invisState.CloneRoot = nil
end
local function createInvisClone()
    destroyInvisClone()
    local s = invisState
    if not s.Char or not s.Char.Parent then return end
    local oldArchivable = s.Char.Archivable
    pcall(function() s.Char.Archivable = true end)
    local clone
    pcall(function() clone = s.Char:Clone() end)
    pcall(function() s.Char.Archivable = oldArchivable end)
    if not clone then return end
    clone.Name = "XitadoInvisibleVisual"
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then obj:Destroy()
        elseif obj:IsA("BasePart") then
            pcall(function() obj.CanCollide = false; obj.CanTouch = false; obj.CanQuery = false; obj.Massless = true end)
        end
    end
    local cloneHum = clone:FindFirstChildOfClass("Humanoid")
    if cloneHum then
        pcall(function()
            cloneHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            cloneHum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
            cloneHum.NameDisplayDistance = 0
            cloneHum:ChangeState(Enum.HumanoidStateType.Physics)
        end)
    end
    local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
    if not cloneRoot then clone:Destroy(); return end
    clone.Parent = Workspace
    s.Clone = clone; s.CloneRoot = cloneRoot
    local cam = Workspace.CurrentCamera
    if cloneHum and cam then pcall(function() cam.CameraSubject = cloneHum end) end
    local base = s.OrigPos or s.Root.Position
    clone:PivotTo(CFrame.new(base) * (s.Root.CFrame - s.Root.Position))
    s.LastGroundPos = base; s.FallVelocity = 0; s.LastScan = os.clock(); s.LastPassScan = s.LastScan
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BasePart") then pcall(function() obj.Anchored = (obj == cloneRoot) end) end
    end
end
local function mirrorInvisPose()
    local s = invisState
    if not s.Clone or not s.Clone.Parent or not s.Char or not s.Root then return end
    local params = s.MirrorParams
    if not params then
        params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        s.MirrorParams = params
    end
    params.FilterDescendantsInstances = { s.Char, s.Clone }
    local current = s.CloneRoot.Position
    local now = os.clock()
    local dt = math.clamp(now - s.LastScan, 0, 0.1); s.LastScan = now
    local hit = Workspace:Raycast(Vector3.new(current.X, current.Y + 2.5, current.Z), Vector3.new(0, -6000, 0), params)
    local targetY = current.Y
    if hit then
        if s.GroundOffset == nil then
            local init = s.OrigPos and Workspace:Raycast(Vector3.new(s.OrigPos.X, s.OrigPos.Y + 2.5, s.OrigPos.Z), Vector3.new(0, -6000, 0), params)
            s.GroundOffset = (init and s.OrigPos) and (s.OrigPos.Y - init.Position.Y) or 3
        end
        local desired = hit.Position.Y + s.GroundOffset
        if s.SmoothY == nil then s.SmoothY = desired end
        s.SmoothY = s.SmoothY + (desired - s.SmoothY) * math.min(dt * 6, 1)
        targetY = s.SmoothY; s.FallVelocity = 0
        s.LastGroundPos = Vector3.new(s.Root.Position.X, targetY, s.Root.Position.Z)
    else
        s.FallVelocity = math.min(s.FallVelocity + 110 * dt, 180)
        targetY = current.Y - s.FallVelocity * dt; s.SmoothY = targetY
    end
    local target = Vector3.new(s.Root.Position.X, targetY, s.Root.Position.Z)
    s.Clone:PivotTo(CFrame.new(target) * (s.Root.CFrame - s.Root.Position))
    local realMotors = {}
    for _, obj in ipairs(s.Char:GetDescendants()) do if obj:IsA("Motor6D") then realMotors[obj.Name] = obj end end
    for _, obj in ipairs(s.Clone:GetDescendants()) do
        if obj:IsA("Motor6D") and realMotors[obj.Name] then pcall(function() obj.Transform = realMotors[obj.Name].Transform end) end
    end
end
local function startInvisFlight()
    local s = invisState
    if s.Conn then s.Conn:Disconnect(); s.Conn = nil end
    updateInvisRefs()
    if not s.Char or not s.Hum or not s.Root or s.Hum.Health <= 0 then return false end
    local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    s.OrigPos = s.Root.Position; s.OrigAutoRotate = s.Hum.AutoRotate; s.OrigPlatformStand = s.Hum.PlatformStand
    s.OrigJumpHeight = s.Hum.JumpHeight; s.OrigJumpPower = s.Hum.JumpPower
    -- En celular el joystick no genera teclas WASD: usamos MoveDirection y un piso mas alto
    s.WalkSpeed = math.max(s.Hum.WalkSpeed, isTouch and 30 or 16)
    s.GroundOffset = nil; s.SmoothY = nil; s.LastGroundPos = s.OrigPos; s.LastMirror = 0
    if not s.MirrorParams then
        s.MirrorParams = RaycastParams.new()
        s.MirrorParams.FilterType = Enum.RaycastFilterType.Exclude
    end
    setupInvisGroups(); clearInvisGroupConns()
    assignInvisGroup(s.Char, GROUP_INVISIBLE); tagOtherPlayers(); createInvisClone()
    pcall(function()
        s.Root.CFrame = s.Root.CFrame + Vector3.new(0, INVIS_ALTITUDE, 0)
        s.Hum.AutoRotate = false; s.Hum.PlatformStand = true
        s.Hum.JumpHeight = 0; s.Hum.JumpPower = 0
        s.Hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    end)
    s.Conn = RunService.Heartbeat:Connect(function()
        if not invisState.Enabled then return end
        local cur = invisState
        if not cur.Char or not cur.Char.Parent or not cur.Hum or not cur.Root or cur.Hum.Health <= 0 then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local visualHum = cur.Clone and cur.Clone:FindFirstChildOfClass("Humanoid")
        if visualHum and cam.CameraSubject ~= visualHum then pcall(function() cam.CameraSubject = visualHum end) end
        local passInterval = isTouch and 0.4 or 0.2
        if os.clock() - cur.LastPassScan >= passInterval then cur.LastPassScan = os.clock(); setOthersPassThrough(true) end
        local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
        local horizontal = Vector3.zero
        local moveDir = cur.Hum.MoveDirection
        if moveDir and moveDir.Magnitude > 0.01 then
            horizontal = Vector3.new(moveDir.X, 0, moveDir.Z)
        else
            local direction = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += right end
            horizontal = Vector3.new(direction.X, 0, direction.Z)
        end
        if horizontal.Magnitude > 0.01 then horizontal = horizontal.Unit * cur.WalkSpeed else horizontal = Vector3.zero end
        local pos = cur.Root.Position
        local y = (cur.OrigPos and cur.OrigPos.Y or 0) + INVIS_ALTITUDE
        local flatLook = Vector3.new(look.X, 0, look.Z)
        cur.Root.CFrame = CFrame.new(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X, y, pos.Z) + flatLook)
        cur.Root.AssemblyLinearVelocity = Vector3.new(horizontal.X, 0, horizontal.Z)
        cur.Root.AssemblyAngularVelocity = Vector3.zero
        local now = os.clock()
        if now - cur.LastMirror >= (isTouch and 1 / 20 or 1 / 30) then
            cur.LastMirror = now
            mirrorInvisPose()
        end
    end)
    return true
end
local function stopInvisFlight()
    local s = invisState
    if s.Conn then s.Conn:Disconnect(); s.Conn = nil end
    destroyInvisClone(); resetInvisGroup(s.Char); clearInvisGroupConns()
    task.delay(0.4, function() if not invisState.Enabled then setOthersPassThrough(false) end end)
    s.GroundOffset = nil; s.SmoothY = nil
    local cam = Workspace.CurrentCamera
    if cam and s.Hum and s.Hum.Parent then pcall(function() cam.CameraSubject = s.Hum end) end
    local land = s.LastGroundPos or s.OrigPos
    if s.Root and s.Root.Parent and land then
        pcall(function()
            s.Root.CFrame = CFrame.new(land.X, land.Y, land.Z)
            s.Root.AssemblyLinearVelocity = Vector3.zero; s.Root.AssemblyAngularVelocity = Vector3.zero
        end)
        if s.Hum and s.Hum.Parent then
            pcall(function()
                s.Hum.PlatformStand = s.OrigPlatformStand == true
                s.Hum.AutoRotate = s.OrigAutoRotate ~= false
                if s.OrigJumpHeight ~= nil then s.Hum.JumpHeight = s.OrigJumpHeight end
                if s.OrigJumpPower ~= nil then s.Hum.JumpPower = s.OrigJumpPower end
                s.Hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                s.Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
    end
    applyInvisTransparency(false)
end
setInvisible = function(on)
    on = on == true
    if invisState.Enabled == on then return true end
    updateInvisRefs()
    if on then
        if not invisState.Char or not invisState.Hum or not invisState.Root or invisState.Hum.Health <= 0 then return false end
        invisState.Enabled = true
        applyInvisTransparency(true)
        if not startInvisFlight() then
            invisState.Enabled = false; applyInvisTransparency(false); refreshButtons(); return false
        end
    else
        invisState.Enabled = false
        stopInvisFlight()
    end
    refreshButtons()
    return true
end

