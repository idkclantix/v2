local function isLocalAimingAt(char)
    local cam = Workspace.CurrentCamera; if not cam then return false end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return false end
    local toTarget = (root.Position - cam.CFrame.Position).Unit
    return cam.CFrame.LookVector:Dot(toTarget) >= AIM_CONE_DOT
end

local function watchEnemyHealth(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local lastHP = hum.Health
    char.ChildAdded:Connect(function(child)
        if child.Name=="Creator" or child.Name=="creator" or child.Name=="KilledBy" then
            local sv = child:IsA("StringValue") and child.Value or nil
            local ov = child:IsA("ObjectValue") and child.Value or nil
            local isOther = (sv and sv~=MY_ROBLOX_NAME) or (ov and ov~=player)
            if isOther then localDamagedChars[char] = nil end
        end
    end)
    hum.HealthChanged:Connect(function(newHP)
        if newHP >= lastHP then lastHP = newHP; return end; lastHP = newHP
        local myChar = player.Character; local tool = myChar and myChar:FindFirstChildOfClass("Tool")
        local gunReady = (tool and isGun(tool)) or (tick()-lastGunHolsteredAt.t) <= GUN_HOLSTER_GRACE
        if gunReady and isLocalAimingAt(char) then localDamagedChars[char] = tick() end
    end)
end

local function didLocalPlayerKill(character)
    if isCreatorLocalPlayer(character) then return true end
    local t = localDamagedChars[character]
    if t and (tick()-t) <= LOCAL_HIT_WINDOW then return true end
    return false
end

