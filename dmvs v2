-- ═══════════════════════════════════════════════════════════════
local KILLALL_SWING_INTERVAL = 0.07
local KillAllState = { Conn = nil, Acc = 0 }

local function startKillAll()
    if KillAllState.Conn then KillAllState.Conn:Disconnect() end
    KillAllState.Acc = 0
    if not Extras.IsKnifeAura() then
        Extras.SetKnifeAuraEnabled(true)
    end
    KillAllState.Conn = RunService.Heartbeat:Connect(function(dt)
        if not KillAllState.Conn then return end
        KillAllState.Acc = KillAllState.Acc + dt
        if KillAllState.Acc < KILLALL_SWING_INTERVAL then return end
        KillAllState.Acc = 0
        local char = player.Character; if not char then return end
        local myHum = char:FindFirstChildOfClass("Humanoid")
        if not myHum or myHum.Health <= 0 then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if not (tool and isKnife(tool)) then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if isEnemy(plr) and plr.Character then
                local eHum  = plr.Character:FindFirstChildOfClass("Humanoid")
                local eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                if eHum and eHum.Health > 0 and eRoot then
                    Extras.SwingKnifeAt(eRoot)
                end
            end
        end
    end)
end

local function stopKillAll()
    if KillAllState.Conn then KillAllState.Conn:Disconnect(); KillAllState.Conn = nil end
end

