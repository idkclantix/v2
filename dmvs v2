        table.clear(floatConns); clearGroupConns()
        if pollConn then pollConn:Disconnect(); pollConn=nil end
        for id,fb in pairs(buttons) do pcall(function() fb.Gui:Destroy() end); buttons[id]=nil end
    end

    return M
end)()

