    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    -- Usamos el mismo detector de lobby que el resto del script.
    local isInLobby = estaEnLobby

    local function wandEquipped()
        local char = player.Character
        if not char then return false end
        local held = char:FindFirstChildOfClass("Tool")
        if not held then return false end
        return held == M.Tool or held.Name == TOOL_NAME or held:GetAttribute("XitadoToolSlot") == TOOL_SLOT
    end

    local function ensureFolder()
        if M.Folder and M.Folder.Parent then return M.Folder end
        local f = Workspace:FindFirstChild("XitadoWandFX")
        if not f then
            f = Instance.new("Folder")
            f.Name = "XitadoWandFX"
            f.Parent = Workspace
        end
        M.Folder = f
        return f
    end

    local function makeTool()
        local tool = Instance.new("Tool")
        tool.Name = TOOL_NAME
        tool.RequiresHandle = true
        tool.CanBeDropped = false
        -- Varios nombres de atributo para que cualquier logica de slots del juego
        -- (o de un executor) detecte esta tool como la del slot 3.
        for _, key in ipairs({ "XitadoToolSlot", "Slot", "ToolSlot", "EquipSlot", "InventorySlot" }) do
            tool:SetAttribute(key, TOOL_SLOT)
        end
        local stick = Instance.new("Part")
        stick.Name = "Handle"
        stick.Size = Vector3.new(0.35, 5, 0.35)
        stick.Material = Enum.Material.Wood
        stick.Color = Color3.fromRGB(139, 94, 54)
        stick.CanCollide = false
        stick.CastShadow = false
        stick.Parent = tool
        return tool
    end

    local function findWandTools()
        local list = {}
        local char = player.Character
        local pack = player:FindFirstChildOfClass("Backpack")
        for _, cont in ipairs({ char, pack }) do
            if cont then
                for _, o in ipairs(cont:GetChildren()) do
                    if o:IsA("Tool") and (o.Name == TOOL_NAME or o:GetAttribute("XitadoToolSlot") == TOOL_SLOT) then
                        list[#list+1] = o
                    end
                end
            end
        end
        return list
    end

    -- La hotbar de Roblox asigna el slot segun el orden en que entran las tools.
    -- Reparentar una tool existente la mueve al primer slot libre (slot 1), asi que
    -- NUNCA hacemos eso: solo recreamos la varita cuando hace falta.
    local function hotbarName(slotIndex)
        local ok, name = pcall(function()
            local rg = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
            local bp = rg and rg:FindFirstChild("Backpack")
            local hb = bp and bp:FindFirstChild("Hotbar")
            local s = hb and hb:FindFirstChild(tostring(slotIndex))
            local tn = s and s:FindFirstChild("ToolName")
            return tn and tn.Text or ""
        end)
        return ok and name or ""
    end

    local function wandInSlot3()
        return hotbarName(3) == TOOL_NAME
    end

    -- Si por algun motivo la varita quedo en otro slot, reinsertamos las tools
    -- en orden (knife, gun, varita) para que Roblox le asigne el slot 3.
    local function reseatTools()
        if destroyed or M.Reordering then return end
        local pack = player:FindFirstChildOfClass("Backpack")
        local char = player.Character
        if not pack then return end
        if char and char:FindFirstChildOfClass("Tool") then return end
        if tick() - M.LastReorder < 4 then return end
        M.LastReorder = tick()
        M.Reordering = true
        local others, fillers = {}, {}
        local fillerNames = { "XitadoSlot1", "XitadoSlot2" }
        local isFiller = { [fillerNames[1]] = true, [fillerNames[2]] = true }
        for _, o in ipairs(pack:GetChildren()) do
            if o:IsA("Tool") and o ~= M.Tool and o.Name ~= TOOL_NAME and not isFiller[o.Name] then
                others[#others + 1] = o
            elseif o:IsA("Tool") and isFiller[o.Name] then
                pcall(function() o:Destroy() end)
            end
        end
        -- Si el juego no da cuchillo/pistola, ponemos herramientas vacias para
        -- que la varita siga cayendo en el slot 3.
        while #others < 2 do
            local t = Instance.new("Tool")
            t.Name = fillerNames[#others + 1]
            t.RequiresHandle = false
            t.CanBeDropped = false
            fillers[#fillers + 1] = t
            others[#others + 1] = t
        end
        if M.Tool then pcall(function() M.Tool:Destroy() end) end
        for _, t in ipairs(others) do pcall(function() t.Parent = nil end) end
        task.wait(0.2)
        for _, t in ipairs(others) do
            pcall(function() t.Parent = pack end)
            task.wait(0.15)
        end
        local tool = makeTool()
        M.Tool = tool
        tool.Parent = pack
        task.wait(0.2)
        M.Reordering = false
    end

    local function watchBackpack()
        local pack = player:FindFirstChildOfClass("Backpack")
        if not pack or pack == M.WatchedPack then return end
        M.WatchedPack = pack
        -- El watcher principal se encarga de reentregar/recolocar la varita.
    end

    -- Guarda una copia sin parent antes de borrar, para el boton "restaurar cosas".
    local function rememberDeleted(part)
        if not part or not part.Parent then return end
        local ok, clone = pcall(function() return part:Clone() end)
        if not ok or not clone then return end
        table.insert(M.Deleted, { Clone = clone, Parent = part.Parent })
    end

    -- Reentrega la varita si desaparecio y elimina cualquier duplicado.
    local function giveTool()
        if destroyed or M.Reordering then return end
        local tools = findWandTools()
        local keep = nil
        for _, t in ipairs(tools) do
            if t.Parent == player.Character then keep = t; break end -- priorizar la que esta equipada
        end
        keep = keep or tools[1]
        for _, t in ipairs(tools) do
            if t ~= keep then pcall(function() t:Destroy() end) end
        end
        if keep and keep.Parent then
            M.Tool = keep
            return keep
        end
        local tool = makeTool()
        M.Tool = tool
        tool.Parent = player:FindFirstChildOfClass("Backpack") or player.Character
        return tool
    end

    local function clearMark(part)
        if not part then return end
        local h = M.Marks[part]
        if h then pcall(function() h:Destroy() end); M.Marks[part] = nil end
        M.Clicks[part] = nil
        if M.Current == part then M.Current = nil end
    end

    local function clearCurrentMark()
        if M.Current then clearMark(M.Current) end
    end

    local function markPart(part)
        if M.Marks[part] then return end
        local h = Instance.new("Highlight")
        h.Name = "XitadoWandEdge"
        h.Adornee = part
        h.FillTransparency = 1
        h.OutlineColor = Color3.new(1, 1, 1)
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = ensureFolder()
        M.Marks[part] = h
        M.Current = part -- solo esta parte queda con contorno blanco
    end

    local function onPartClick(screenPos)
        if not M.Enabled or destroyed then return end
        if not wandEquipped() then return end   -- debe estar en la mano, no solo en el inventario
        if isInLobby() then return end          -- en el lobby no se puede usar
        local cam = Workspace.CurrentCamera
        if not cam or typeof(screenPos) ~= "Vector2" then return end
        local now = os.clock()
        if now - lastClick < CLICK_DEDUPE then return end
        lastClick = now
        local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y, 0)
        rayParams.FilterDescendantsInstances = { player.Character }
        local hit = Workspace:Raycast(ray.Origin, ray.Direction * 1200, rayParams)
        if not hit then return end
        local part = hit.Instance
        if not part or not part:IsA("BasePart") then return end
        local model = part:FindFirstAncestorOfClass("Model")
        if model and Players:GetPlayerFromCharacter(model) then return end
        if part:FindFirstAncestor("XitadoWandFX") or string.find(part.Name, "Xitado", 1, true) then return end

        -- Misma parte marcada: segundo clic lo borra (y se guarda para restaurar).
        if M.Current == part then
            clearMark(part)
            rememberDeleted(part)
            pcall(function() part:Destroy() end)
            return
        end
        -- Parte distinta: se quita el contorno anterior y queda solo el nuevo.
        clearCurrentMark()
        M.Clicks[part] = 1
        markPart(part)
    end

    local function connectInputs()
        table.insert(M.Conns, UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed or not M.Enabled then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                onPartClick(UserInputService:GetMouseLocation())
            elseif input.UserInputType == Enum.UserInputType.Touch then
                local cam = Workspace.CurrentCamera
                local vp = cam and cam.ViewportSize
                if vp and input.Position.X >= vp.X * 0.5 then return end -- derecha = camara
                local pos = Vector2.new(input.Position.X, input.Position.Y)
                M.Touch.Active[input] = pos
                M.Touch.Start[input] = pos
                M.Touch.Drag[input] = false
                M.Touch.Time[input] = os.clock()
            end
        end))
        table.insert(M.Conns, UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            local start = M.Touch.Start[input]
            if start and (Vector2.new(input.Position.X, input.Position.Y) - start).Magnitude > 12 then
                M.Touch.Drag[input] = true
                M.Touch.Active[input] = nil
            end
        end))
        table.insert(M.Conns, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            local active = M.Touch.Active[input]
            local dragged = M.Touch.Drag[input]
            local t0 = M.Touch.Time[input]
            M.Touch.Active[input] = nil
            M.Touch.Start[input] = nil
            M.Touch.Drag[input] = nil
            M.Touch.Time[input] = nil
            if active and not dragged and t0 and (os.clock() - t0) <= 0.3 then
                onPartClick(Vector2.new(input.Position.X, input.Position.Y))
            end
        end))
        table.insert(M.Conns, player.CharacterAdded:Connect(function()
            task.wait(0.3)
            if M.Enabled and not destroyed then giveTool() end
        end))
        -- Si se desequipa la varita (por ejemplo equipan el cuchillo), los bordes
        -- de las partes marcadas deben desaparecer.
        local equipAcc = 0
        table.insert(M.Conns, RunService.Heartbeat:Connect(function(dt)
            if not M.Enabled then equipAcc = 0; return end
            equipAcc = equipAcc + dt
            if equipAcc < 0.1 then return end
            equipAcc = 0
            if M.Current and not wandEquipped() then
                for part in pairs(M.Marks) do clearMark(part) end
                table.clear(M.Clicks)
                M.Current = nil
            end
        end))
    end

    function M.Enable()
        if M.Enabled then return end
        M.Enabled = true
        ensureFolder()
        giveTool()
        watchBackpack()
        connectInputs()
        -- Vigilar que la varita nunca falte, no se duplique y siga en el slot 3.
        M.WatchGen = M.WatchGen + 1
        local gen = M.WatchGen
        task.spawn(function()
            while gen == M.WatchGen and M.Enabled and not destroyed do
                task.wait(0.5)
                if gen ~= M.WatchGen or not M.Enabled or destroyed then break end
                watchBackpack()
                if not M.Reordering then
                    giveTool()
                    if M.Tool and M.Tool.Parent and not wandInSlot3() then
                        reseatTools()
                    end
                end
            end
        end)
    end

    -- Devuelve las partes borradas con la varita a su lugar original.
    function M.Restore()
        local restored = 0
        for i = #M.Deleted, 1, -1 do
            local entry = M.Deleted[i]
            local clone = entry and entry.Clone
            if clone then
                local dest = entry.Parent
                if not dest or not dest.Parent then dest = Workspace end
                if dest and dest.Parent then
                    pcall(function() clone.Parent = dest end)
                    restored = restored + 1
                end
            end
            table.remove(M.Deleted, i)
        end
        return restored
    end

    -- Expuesto para pruebas / uso directo: Click(screenPos) hace lo mismo que un clic del mouse.
    function M.Click(screenPos) onPartClick(screenPos) end

    function M.Disable()
        M.Enabled = false
        M.WatchGen = M.WatchGen + 1
        for _, c in ipairs(M.Conns) do pcall(function() c:Disconnect() end) end
        table.clear(M.Conns)
        M.WatchedPack = nil
        clearCurrentMark()
        for part in pairs(M.Marks) do clearMark(part) end
        table.clear(M.Clicks)
        M.Current = nil
        if M.Tool then pcall(function() M.Tool:Destroy() end); M.Tool = nil end
        local pack = player:FindFirstChildOfClass("Backpack")
        if pack then
            for _, t in ipairs(pack:GetChildren()) do
                if t:IsA("Tool") and (t.Name == "XitadoSlot1" or t.Name == "XitadoSlot2") then
                    pcall(function() t:Destroy() end)
                end
            end
        end
        if M.Folder then pcall(function() M.Folder:Destroy() end); M.Folder = nil end
        table.clear(M.Touch.Active)
        table.clear(M.Touch.Start)
        table.clear(M.Touch.Drag)
        table.clear(M.Touch.Time)
    end

    getgenv().XitadoWand = M -- API publica para probar/usar la varita desde el executor.
    return M
end)()

return {
    Walk = modWalk, StopWalk = modStopWalk, StartWalk = modStartWalk,
    KillSound = modKillSound, KillSoundOptions = modKillSoundOptions,
    KillSoundVolumes = ModKillSoundVolumes, ApplyKillSoundConfig = modApplyKillSoundConfig,
    SetKillSoundMute = modSetKillSoundMute, PlayKillSound = modPlayKillSound,
    KillFX = modKillFX, FXNames = ModFXNames, FXInfo = ModFXInfo,
    StartKillDetection = modStartKillDetection, StopKillDetection = modStopKillDetection,
    StartShootWatchers = modStartShootWatchers, StopShootWatchers = modStopShootWatchers,
    ShootSound = modShootSound, ShootNames = modShootNames, ShootSounds = ModShootSounds,
    Streak = modStreak, Cursor = modCursor, Wand = modWand,
    DeathSoundConns = modDeathSoundConns, RemoteConns = modRemoteConns, StatConns = modStatConns,
    EffectBuilders = modEffectBuilders, FXTemplateCache = modFXTemplateCache,
    KillSoundPlayer = ModKillSoundPlayer, ShootSoundPlayer = ModShootSoundPlayer,
}
end

