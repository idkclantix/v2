local espAcc = 0
espConnection = RunService.RenderStepped:Connect(function(dt)
    if destroyed then return end
    espAcc = espAcc + dt
    if espAcc < 1/30 then return end -- 30 Hz: las lines/names siguen fluidos y se corta el costo por frame
    espAcc = 0
    local cam = workspace.CurrentCamera
    if not cam then return end
    local myChar = player.Character
    if not myChar then
        for p in pairs(activeESPs) do cleanESP(p) end
        return
    end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local viewport = cam.ViewportSize

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer == player then continue end
        local allyFlag  = esCompaneroDeEquipo(targetPlayer) and not isEnemy(targetPlayer)
        local enemyFlag = isEnemy(targetPlayer)
        local cfg = enemyFlag and espEnemy or (allyFlag and espAlly or nil)
        if not cfg or not cfg.Enabled then cleanESP(targetPlayer); continue end

        local char = targetPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then cleanESP(targetPlayer); continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then cleanESP(targetPlayer); continue end
        if (root.Position - cam.CFrame.Position).Magnitude > MAX_ESP_DISTANCE then cleanESP(targetPlayer); continue end

        local espObj = activeESPs[targetPlayer]
        if not espObj then
            espObj = {}
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_Highlight"
            highlight.Adornee = char
            highlight.FillColor = cfg.Color
            highlight.OutlineColor = cfg.Color
            highlight.FillTransparency = 0.6
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            pcall(function() highlight.Parent = espFolder end)
            espObj.Highlight = highlight
            activeESPs[targetPlayer] = espObj
        end

        local color = cfg.Color
        if espObj.Highlight then
            espObj.Highlight.FillColor = color
            espObj.Highlight.OutlineColor = color
            espObj.Highlight.Adornee = char
        end

        if cfg.Line then
            if not espObj.Line then espObj.LineGui, espObj.Line = createLineESP(targetPlayer) end
            local screenPos, onScreen = cam:WorldToViewportPoint(root.Position)
            if onScreen and screenPos.Z > 0 then
                local from = Vector2.new(viewport.X / 2, viewport.Y)
                local to = Vector2.new(screenPos.X, screenPos.Y)
                local delta = to - from
                local midpoint = (from + to) / 2
                espObj.Line.Position = UDim2.fromOffset(midpoint.X, midpoint.Y)
                espObj.Line.Size = UDim2.fromOffset(delta.Magnitude, 1.5)
                espObj.Line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                espObj.Line.BackgroundColor3 = color
                espObj.Line.Visible = true
            else
                espObj.Line.Visible = false
            end
        elseif espObj.Line then
            espObj.Line.Visible = false
        end

        if cfg.Names or cfg.Studs then
            if not espObj.NameLabel then
                espObj.NameGui, espObj.NameLabel, espObj.StudsLabel = createNameESP(targetPlayer)
            end
            local head = char:FindFirstChild("Head") or root
            local headPos, onScreen = cam:WorldToViewportPoint(head.Position)
            if onScreen and headPos.Z > 0 then
                if cfg.Names and espObj.NameLabel then
                    espObj.NameLabel.Position = UDim2.fromOffset(headPos.X, headPos.Y - 20)
                    espObj.NameLabel.TextColor3 = color
                    espObj.NameLabel.Text = targetPlayer.Name
                    espObj.NameLabel.Visible = true
                elseif espObj.NameLabel then
                    espObj.NameLabel.Visible = false
                end
                if cfg.Studs and espObj.StudsLabel and myRoot then
                    local dist = math.floor((root.Position - myRoot.Position).Magnitude)
                    espObj.StudsLabel.Position = UDim2.fromOffset(headPos.X, headPos.Y + 4)
                    espObj.StudsLabel.TextColor3 = color
                    espObj.StudsLabel.Text = dist .. " studs"
                    espObj.StudsLabel.Visible = true
                elseif espObj.StudsLabel then
                    espObj.StudsLabel.Visible = false
                end
            else
                if espObj.NameLabel then espObj.NameLabel.Visible = false end
                if espObj.StudsLabel then espObj.StudsLabel.Visible = false end
            end
        end
    end

    for p in pairs(activeESPs) do
        if not p.Parent or not p.Character then cleanESP(p) end
    end
end)

