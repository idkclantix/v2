-- ============================================================
-- AUTO KILL = TELEKILL de 01ROXHUB (autocontenido)
-- Logica identica al toggle "TELEKILL [SOLO ARMA]":
--  1) teletransportarse detras del enemigo (LoopAtrasSolo)
--  2) siempre tener el arma equipada mientras esta activo (altoFire)
--  3) ALTO FIRE [AGRESIVO]: barrer partes visibles y Activate()/Deactivate()
-- El hook de silent aim del hub redirige el raycast a XitadoHubTargetPart.
-- Reutiliza el teamcheck del hub (esEnemigoValido / estaEnLobby).
-- ============================================================
autoKillState = { Enabled = false, Threads = {}, Target = nil, EquippedAt = 0 }
local AUTO_KILL_BEHIND = 6
local AUTO_KILL_RANGE = 200

-- Lobby robusto: ForceField/nombre de equipo + scoreboard (como 01rox).
-- Si el scoreboard existe y el local no esta en TeamRed/TeamBlue, estamos en lobby.
local function autoKillIsLobby()
    if estaEnLobby() then return true end
    local pg = player:FindFirstChild("PlayerGui")
    local score = pg and pg:FindFirstChild("IngameScore", true)
    if not score then return false end
    local red = score:FindFirstChild("TeamRed")
    local blue = score:FindFirstChild("TeamBlue")
    if not red and not blue then return true end
    local myName = string.lower(player.Name)
    local myDisplay = player.DisplayName and string.lower(player.DisplayName) or myName
    for _, folder in ipairs({ red, blue }) do
        if folder then
            for _, e in ipairs(folder:GetChildren()) do
                local n = string.lower(e.Name)
                if n == myName or n == myDisplay then return false end
            end
        end
    end
    return true
end

local function autoKillAddThread(fn)
    local t = task.spawn(fn)
    table.insert(autoKillState.Threads, t)
    return t
end

local function autoKillStopThreads()
    for _, t in ipairs(autoKillState.Threads) do pcall(task.cancel, t) end
    table.clear(autoKillState.Threads)
end

local function autoKillNearestEnemy()
    local char = player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot or autoKillIsLobby() then return nil end
    local nearest, nearestDist = nil, AUTO_KILL_RANGE
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and esEnemigoValido(p) and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local d = (myRoot.Position - root.Position).Magnitude
                if d < nearestDist then nearestDist = d; nearest = p end
            end
        end
    end
    return nearest
end

-- 1) Teletransporte detras del enemigo (LoopAtrasSolo de 01rox)
local function autoKillTeleportLoop()
    while autoKillState.Enabled and not destroyed do
        local char = player.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if autoKillIsLobby() or not myRoot then
            autoKillState.Target = nil
            if getgenv then getgenv().XitadoHubTargetPart = nil end
            task.wait(0.3)
        else
            local target = autoKillNearestEnemy()
            if target and target.Character then
                local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                local tHum = target.Character:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum and tHum.Health > 0 then
                    local behind = tRoot.CFrame * CFrame.new(0, 0, AUTO_KILL_BEHIND)
                    pcall(function()
                        myRoot.CFrame = CFrame.lookAt(behind.Position, tRoot.Position)
                        myRoot.AssemblyLinearVelocity = Vector3.zero
                        myRoot.AssemblyAngularVelocity = Vector3.zero
                    end)
                    -- Comparte el enemigo con el loop de disparo. NO escribir
                    -- XitadoHubTargetPart aca: antes se pisaba cada frame con
                    -- otra parte/enemigo y el primer tiro salia de costado.
                    autoKillState.Target = target
                end
            else
                autoKillState.Target = nil
                if getgenv then getgenv().XitadoHubTargetPart = nil end
            end
            RunService.Heartbeat:Wait()
        end
    end
end

-- 2) Siempre tener el arma equipada mientras Auto Kill esta activo
local function autoKillEquipLoop()
    while autoKillState.Enabled and not destroyed do
        task.wait(0.2)
        if autoKillIsLobby() then continue end
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum then continue end
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped and esPistola(equipped) then continue end -- ya tiene arma
        local gun = obtenerPistola()
        if gun and gun.Parent ~= char then
            if pcall(function() hum:EquipTool(gun) end) then
                autoKillState.EquippedAt = os.clock() -- no disparar durante la transicion de equip
            end
        end
    end
end

-- 3) ALTO FIRE [AGRESIVO] de 01rox: barre partes visibles y dispara.
local function autoKillFireLoop()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    while autoKillState.Enabled and not destroyed do
        task.wait(0.1)
        if autoKillIsLobby() then
            if getgenv then getgenv().XitadoHubTargetPart = nil end
            continue
        end
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        local arma = char:FindFirstChildOfClass("Tool")
        if not arma or not arma:FindFirstChild("Handle") or esCuchillo(arma) then
            if getgenv then getgenv().XitadoHubTargetPart = nil end
            continue
        end
        -- No disparar mientras el arma se esta equipando (el primer Activate
        -- podia salir sin direccion valida: costados/arriba/abajo).
        if os.clock() - autoKillState.EquippedAt < 0.15 then continue end

        -- Un solo enemigo para TP y disparo: el que eligio el loop de teletransporte.
        local target = autoKillState.Target
        if not target or not target.Character or not esEnemigoValido(target) then
            target = autoKillNearestEnemy()
            autoKillState.Target = target
        end
        local closestPart, shortest = nil, math.huge
        local closestTorso, torsoDist = nil, math.huge
        if target and target.Character then
            local enemyHum = target.Character:FindFirstChildOfClass("Humanoid")
            if enemyHum and enemyHum.Health > 0 then
                local myPos = char.HumanoidRootPart.Position
                local headPos = char:FindFirstChild("Head") and char.Head.Position or myPos
                params.FilterDescendantsInstances = { char, target.Character }
                for _, part in ipairs(target.Character:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        local isTorso = part.Name == "UpperTorso" or part.Name == "Torso"
                        local d = (part.Position - myPos).Magnitude
                        if isTorso then
                            if d >= torsoDist then continue end
                        elseif d >= shortest then
                            continue
                        end
                        local size = part.Size
                        local offsets = { Vector3.zero, Vector3.new(0, size.Y / 2.1, 0), Vector3.new(0, -size.Y / 2.1, 0) }
                        for _, off in ipairs(offsets) do
                            if not workspace:Raycast(headPos, (part.CFrame * off) - headPos, params) then
                                if isTorso then torsoDist = d; closestTorso = part
                                else shortest = d; closestPart = part end
                                break
                            end
                        end
                    end
                end
            end
        end
        closestPart = closestTorso or closestPart -- torso siempre tiene prioridad
        if closestPart and closestPart.Parent then
            local aimPart = closestPart
            -- Fijar objetivo antes de disparar y alinear la camara: si el juego
            -- no redirige el raycast, el tiro igual va al enemigo correcto.
            if getgenv then getgenv().XitadoHubTargetPart = aimPart end
            local cam = workspace.CurrentCamera
            if cam then
                pcall(function()
                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimPart.Position)
                end)
            end
            task.wait(0.03)
            local gunNow = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if not gunNow or gunNow.Parent ~= player.Character then continue end
            if getgenv then getgenv().XitadoHubTargetPart = aimPart end
            local fireChar = player.Character
            pcall(function()
                gunNow:Activate()
                task.delay(0.05, function()
                    if gunNow.Parent == fireChar then gunNow:Deactivate() end
                end)
            end)
            task.wait(0.2)
        else
            if getgenv then getgenv().XitadoHubTargetPart = nil end
        end
    end
end

local function setAutoKill(on)
    on = on == true
    if autoKillState.Enabled == on then return end
    autoKillState.Enabled = on
    if on then
        autoKillStopThreads()
        autoKillState.Target = nil
        autoKillState.EquippedAt = os.clock()
        -- El aimbot interno de Auto Kill no toca el toggle del Aimbot del hub.
        autoKillAddThread(autoKillTeleportLoop)
        autoKillAddThread(autoKillEquipLoop)
        autoKillAddThread(autoKillFireLoop) -- ALTO FIRE [AGRESIVO]
    else
        autoKillStopThreads()
        autoKillState.Target = nil
        if getgenv then getgenv().XitadoHubTargetPart = nil end
    end
end

