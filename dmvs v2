-- Racha y colores: solo el HeadTag de este jugador
local modStreak = (function()
    local M = {
        Enabled = false, LockedNumber = nil, Applied = false,
        NameColorOn = false, StreakColorOn = false,
        NameColorWanted = false, StreakColorWanted = false,
        NameColorMode = "Rainbow", StreakColorMode = "Rainbow",
        OriginalTexts = {}, NameOrigColors = {}, StreakOrigColors = {},
        Hue = 0, Speed = 0.4, HueThread = nil, AutoThread = nil,
        NameThread = nil, StreakThread = nil, LastFrame = nil,
    }
    local COLOR_MODES = {
        Rainbow = "rainbow", BluePink = "bluepink", PurplePink = "purplepink",
        Yellow = Color3.fromRGB(255, 220, 40), Green = Color3.fromRGB(80, 220, 100),
        Blue = Color3.fromRGB(70, 150, 255), Purple = Color3.fromRGB(170, 80, 255),
        Pink = Color3.fromRGB(255, 105, 180), Red = Color3.fromRGB(230, 60, 60),
        Brown = Color3.fromRGB(140, 90, 50), Wine = Color3.fromRGB(120, 20, 40),
        Gold = Color3.fromRGB(255, 200, 50),
    }
    local function getFrame()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local ht = root and root:FindFirstChild("HeadTag")
        local sk = ht and ht:FindFirstChild("Streak")
        return sk and sk:FindFirstChild("Streaks") or nil
    end
    local function getNameFrames()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local ht = root and root:FindFirstChild("HeadTag")
        if not ht then return {} end
        local found = {}
        for _, obj in ipairs(ht:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                local n = string.lower(obj.Name)
                if string.find(n, "name", 1, true) or string.find(n, "user", 1, true)
                    or string.find(n, "display", 1, true) or obj.Text == player.Name then
                    found[#found + 1] = obj
                end
            end
        end
        return found
    end
    local function getLabels()
        local frame = getFrame()
        if not frame then return {} end
        local labels = {}
        local function collect(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then labels[#labels + 1] = obj end
        end
        collect(frame)
        for _, d in ipairs(frame:GetDescendants()) do collect(d) end
        return labels
    end
    local function splitNumberAndRest(text)
        if not text or text == "" then return nil, "", text end
        local prefix, num, suffix = string.match(text, "^(.-)(%d+)(.*)$")
        if num then return num, prefix, suffix end
        return nil, "", text
    end
    local function snapshotTexts()
        local frame = getFrame()
        if not frame then return end
        local function snap(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                if M.OriginalTexts[obj] == nil then M.OriginalTexts[obj] = obj.Text end
            end
        end
        snap(frame)
        for _, d in ipairs(frame:GetDescendants()) do snap(d) end
    end
    local function startHue()
        if M.HueThread then return end
        M.HueThread = task.spawn(function()
            while M.NameColorOn or M.StreakColorOn do
                local dt = task.wait(0.03)
                M.Hue = (M.Hue + M.Speed * dt) % 1
            end
            M.HueThread = nil
        end)
    end
    local function resolveColor(mode)
        if mode == "Rainbow" then return Color3.fromHSV(M.Hue % 1, 1, 1) end
        if mode == "BluePink" or mode == "PurplePink" then
            local t = (math.sin(M.Hue * math.pi * 2) + 1) / 2
            if mode == "BluePink" then
                return Color3.fromRGB(70, 150, 255):Lerp(Color3.fromRGB(255, 105, 180), t)
            end
            return Color3.fromRGB(170, 80, 255):Lerp(Color3.fromRGB(255, 105, 180), t)
        end
        local c = COLOR_MODES[mode]
        if typeof(c) == "Color3" then return c end
        return Color3.fromHSV(M.Hue % 1, 1, 1)
    end
    local function applyRaw(newNumber)
        local frame = getFrame()
        if not frame then return false end
        local function applyTo(obj)
            if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
            local base = M.OriginalTexts[obj] ~= nil and M.OriginalTexts[obj] or obj.Text
            local _, prefix, suffix = splitNumberAndRest(base)
            local desired = (prefix or "") .. tostring(newNumber) .. (suffix or "")
            if obj.Text ~= desired then pcall(function() obj.Text = desired end) end
        end
        applyTo(frame)
        for _, d in ipairs(frame:GetDescendants()) do applyTo(d) end
        M.Applied = true
        return true
    end
    local function stopAutoLoop()
        M.AutoLoopActive = false
        if M.AutoThread then pcall(task.cancel, M.AutoThread); M.AutoThread = nil end
        M.LastFrame = nil
    end
    local function startAutoLoop()
        stopAutoLoop()
        M.AutoLoopActive = true
        M.LastFrame = getFrame()
        M.AutoThread = task.spawn(function()
            while M.AutoLoopActive and M.LockedNumber and M.Enabled do
                task.wait(1)
                local cur = getFrame()
                if not cur then M.LastFrame = nil; continue end
                if cur ~= M.LastFrame then
                    table.clear(M.OriginalTexts)
                    M.Applied = false
                    M.LastFrame = cur
                    snapshotTexts()
                end
                applyRaw(M.LockedNumber)
            end
        end)
    end
    function M.Apply(newNumber)
        M.LockedNumber = tostring(newNumber)
        if not M.Enabled then return false end
        if getFrame() then snapshotTexts(); applyRaw(M.LockedNumber) end
        startAutoLoop()
        return true
    end
    function M.Remove()
        stopAutoLoop()
        local frame = getFrame()
        if not frame then M.Applied = false; return false end
        local function restore(obj)
            if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
            local orig = M.OriginalTexts[obj]
            if orig ~= nil then pcall(function() obj.Text = orig end) end
        end
        restore(frame)
        for _, d in ipairs(frame:GetDescendants()) do restore(d) end
        table.clear(M.OriginalTexts)
        M.Applied = false
        return true
    end
    function M.StartNameColor()
        M.NameColorWanted = true
        if M.NameColorOn then return end
        if M.NameThread then pcall(task.cancel, M.NameThread); M.NameThread = nil end
        M.NameColorOn = true
        for _, obj in ipairs(getNameFrames()) do
            if M.NameOrigColors[obj] == nil then M.NameOrigColors[obj] = obj.TextColor3 end
        end
        startHue()
        M.NameThread = task.spawn(function()
            while M.NameColorOn do
                task.wait(0.03)
                local c = resolveColor(M.NameColorMode)
                for _, lbl in ipairs(getNameFrames()) do pcall(function() lbl.TextColor3 = c end) end
            end
        end)
    end
    function M.StopNameColor()
        M.NameColorWanted = false
        M.NameColorOn = false
        if M.NameThread then pcall(task.cancel, M.NameThread); M.NameThread = nil end
        for obj, col in pairs(M.NameOrigColors) do
            if obj and obj.Parent and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                pcall(function() obj.TextColor3 = col end)
            end
        end
        table.clear(M.NameOrigColors)
    end
    function M.StartStreakColor()
        M.StreakColorWanted = true
        if M.StreakColorOn then return end
        if M.StreakThread then pcall(task.cancel, M.StreakThread); M.StreakThread = nil end
        M.StreakColorOn = true
        for _, obj in ipairs(getLabels()) do
            if M.StreakOrigColors[obj] == nil then M.StreakOrigColors[obj] = obj.TextColor3 end
        end
        startHue()
        M.StreakThread = task.spawn(function()
            while M.StreakColorOn do
                task.wait(0.03)
                local c = resolveColor(M.StreakColorMode)
                for _, lbl in ipairs(getLabels()) do pcall(function() lbl.TextColor3 = c end) end
            end
        end)
    end
    function M.StopStreakColor()
        M.StreakColorWanted = false
        M.StreakColorOn = false
        if M.StreakThread then pcall(task.cancel, M.StreakThread); M.StreakThread = nil end
        for obj, col in pairs(M.StreakOrigColors) do
            if obj and obj.Parent and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                pcall(function() obj.TextColor3 = col end)
            end
        end
        table.clear(M.StreakOrigColors)
    end
    function M.Cleanup()
        M.Enabled = false
        stopAutoLoop()
        M.StopNameColor()
        M.StopStreakColor()
        M.Remove()
    end
    player.CharacterAdded:Connect(function()
        local wantName = M.NameColorWanted
        local wantStreak = M.StreakColorWanted
        if M.NameThread then pcall(task.cancel, M.NameThread); M.NameThread = nil end
        if M.StreakThread then pcall(task.cancel, M.StreakThread); M.StreakThread = nil end
        M.NameColorOn = false
        M.StreakColorOn = false
        table.clear(M.OriginalTexts)
        table.clear(M.NameOrigColors)
        table.clear(M.StreakOrigColors)
        M.Applied = false
        task.wait(0.5)
        if destroyed then return end
        if M.Enabled and M.LockedNumber then M.Apply(M.LockedNumber) end
        if wantName then M.StartNameColor() end
        if wantStreak then M.StartStreakColor() end
    end)
    return M
end)()

