--OBJETIVO BAJO EL CLICK: para que el disparo vaya donde tocaste (mobile) y no al centro de la camara.
local macroRayParams = RaycastParams.new()
macroRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function macroAimAtClick(screenPos)
    if not screenPos then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    macroRayParams.FilterDescendantsInstances = { player.Character }
    local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y, 0)
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 900, macroRayParams)
    if not hit or not hit.Instance or not hit.Instance:IsA("BasePart") then return nil end
    local model = hit.Instance:FindFirstAncestorOfClass("Model")
    local plr = model and Players:GetPlayerFromCharacter(model)
    if not plr or not esEnemigoValido(plr) then return nil end
    return hit.Instance
end

local function macroCanRun()
    if not legitMacroEnabled or macroBusy or not IsInMatchStrict() then return false end
    local char = player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool and esCuchillo(tool) then return false end
    return true
end

-- Macro: al picar saca el arma, dispara hacia donde hiciste click y la guarda.
local function runLegitMacro(screenPos)
    if not macroCanRun() then return end
    local nowClick = os.clock()
    if nowClick - macroLastClickTime < MACRO_CLICK_DEDUPE then return end
    macroLastClickTime = nowClick
    macroBusy = true
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if char and hum and hum.Health > 0 then
        local gun = obtenerPistola()
        if gun then
            local clickPart = macroAimAtClick(screenPos)
            local prevTarget = getgenv and getgenv().XitadoHubTargetPart or nil
            local equipOk = true
            if gun.Parent ~= char then
                equipOk = pcall(function() hum:EquipTool(gun) end) and waitToolEquipped(gun, hum, EQUIP_TIMEOUT)
            end
            if equipOk then
                task.wait(SHOOT_SETTLE)
                if clickPart and clickPart.Parent then
                    if getgenv then getgenv().XitadoHubTargetPart = clickPart end
                end
                shootOnce(player.Character, hum)
                if clickPart then
                    task.wait(0.02)
                    if getgenv then getgenv().XitadoHubTargetPart = prevTarget end
                end
                task.wait(EQUIP_HOLD_TIME)
                local humNow = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                if humNow then pcall(function() humNow:UnequipTools() end) end
                task.wait(EQUIP_STOW_TIME)
            end
        end
    end
    macroBusy = false
end

table.insert(legitConns, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not legitMacroEnabled or not macroCanRun() then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        task.spawn(runLegitMacro, UserInputService:GetMouseLocation())
    elseif input.UserInputType == Enum.UserInputType.Touch then
        local cam = Workspace.CurrentCamera
        local width = cam and cam.ViewportSize.X or 0
        if width > 0 and input.Position.X >= width * macroTouch.MinXFraction then
            local startPos = Vector2.new(input.Position.X, input.Position.Y)
            macroTouch.Active[input] = startPos
            macroTouch.StartPos[input] = startPos
            macroTouch.WasDrag[input] = false
            macroTouch.StartTime[input] = os.clock()
        end
    end
end))

table.insert(legitConns, UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    local start = macroTouch.StartPos[input]
    if start then
        local delta = (Vector2.new(input.Position.X, input.Position.Y) - start).Magnitude
        if delta > macroTouch.DragPx then
            macroTouch.WasDrag[input] = true
            macroTouch.Active[input] = nil
        end
    end
end))

table.insert(legitConns, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    local wasActive = macroTouch.Active[input]
    local wasDrag = macroTouch.WasDrag[input]
    local startTime = macroTouch.StartTime[input]
    macroTouch.Active[input] = nil
    macroTouch.StartPos[input] = nil
    macroTouch.WasDrag[input] = nil
    macroTouch.StartTime[input] = nil
    -- Solo cuenta como click real: toque corto, sin arrastrar (mantener para apuntar no dispara)
    local isRealClick = wasActive and not wasDrag
        and startTime ~= nil and (os.clock() - startTime) <= macroTouch.MaxTapTime
    if isRealClick then
        task.spawn(runLegitMacro, Vector2.new(input.Position.X, input.Position.Y))
    end
