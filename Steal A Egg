local function tuneToolBillboard(inst, name)
    if not inst then return end
    local cleanName = name
    if not cleanName and inst:IsA("Tool") then
        cleanName = inst:GetAttribute("DisplayName")
    end
    if not cleanName and inst:IsA("Model") then
        local dir = Assets.Directory[inst:GetAttribute("Category") or ""]
        cleanName = dir and (dir.DisplayName or dir.Name) or nil
    end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BillboardGui") then
            pcall(function() d.Enabled = true end)
            for _, c in ipairs(d:GetDescendants()) do
                if c:IsA("TextLabel") then
                    if c.Name == "DisplayName" and cleanName then
                        pcall(function()
                            c.Text = cleanName
                            c.Visible = true
                        end)
                    else
                        pcall(function() c.Visible = (c.Name == "PerSecond") end)
                    end
                end
            end
        end
    end
end

