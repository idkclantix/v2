local hudTick = 0
local toolTick = 0
track(RunService.RenderStepped:Connect(function(dt)
    local rate = 0
    local t = os.clock()

    for slot, rec in pairs(placed) do
        if rec.model and rec.model.Parent then
            rate += rateFor(rec)
            local cur = rec.model:GetPivot()
            local moveT = t * rec.speed + rec.phase
            local target = patrolPose(slot, moveT)
            local ahead = patrolPose(slot, moveT + 0.12)
            local dir = Vector3.new(ahead.X - target.X, 0, ahead.Z - target.Z)
            if dir.Magnitude < 0.01 then dir = cur.LookVector end
            target = target + Vector3.new(0, math.sin(t * 1.6 + rec.phase) * 0.04, 0)
            local face = CFrame.lookAt(target, target + dir)
            pcall(function() rec.model:PivotTo(cur:Lerp(face, math.clamp(dt * 2.5, 0, 1))) end)
        else
            placed[slot] = nil
        end
    end

    currentRate = rate
    updateLeaderstats(rate)

    if settings.overrideHUD then
        fakeMoney = math.min(fakeMoney + rate * dt, MONEY_CAP)
    end

    toolTick += dt
    if toolTick >= 0.5 then
        toolTick = 0
        refreshFakeInventory()
        for _, entry in pairs(fakeToolsList) do
            if entry.tool and entry.tool.Parent == LP.Character then tuneToolBillboard(entry.tool) end
        end
       
        for _, container in ipairs({ LP.Backpack, LP.Character }) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") and t:GetAttribute("FakePetLocal") then
                        local tracked = false
                        for _, entry in pairs(fakeToolsList) do
                            if entry.tool == t then tracked = true break end
                        end
                        if not tracked then pcall(function() t:Destroy() end) end
                    end
                end
            end
        end
    end

    hudTick += dt
    if hudTick >= 0.1 then
        hudTick = 0
        watchRealHUD()
    end
end))

