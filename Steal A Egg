    local tool
    if AssetToolRig then
        local ok, built = pcall(function() return AssetToolRig.Build(rec.itemData, uid, LP) end)
        if ok and built and built:IsA("Tool") then tool = built end
    end
    if not tool then tool = buildFallbackTool(rec, uid) end
    if not tool then
        notify({ Title = "Xitado Hub", Content = "No se pudo crear la mascota visible.", Duration = 3 })
        return nil
    end

    fakeUIDs[uid] = true
    tool:SetAttribute("FakePetLocal", true)
    tool:SetAttribute("ItemType", "Asset")
    tool:SetAttribute("UID", uid)
    tool:SetAttribute("Category", rec.cat)
    tool:SetAttribute("DisplayName", rec.label)
    tool:SetAttribute("Mutations", table.concat(rec.itemData.Mutations or {}, ","))
    tool.Name = rec.label .. " [Fake]"
    tool.Parent = LP.Backpack
    local entry = { tool = tool, uid = uid, slot = slot }
    fakeTools[slot] = entry
    fakeToolsList[uid] = entry

    if not fakeInventory[uid] then fakeInventory[uid] = inventoryRecord(rec, uid) end
    refreshFakeInventory()

    track(tool.Equipped:Connect(function()
     
        task.defer(function() tuneToolBillboard(tool) end)
    end))
    track(tool.Activated:Connect(function()
    
        if not nearPlot() then return end
        if AssetPlacementHints then
            pcall(function() AssetPlacementHints.ClearFrontPlacement(uid) end)
        end
        local data = itemDataFromTool(tool)
        local s = nextFreeSlot()
        if not s then
            notifyFull()
            return
        end
        if spawnRecord(s, data.Category, data, slotPos(s), uid, fakeInventory[uid]) then
            settings.slot = s
            settings.plotSlot = s
            pcall(function() if slotDropdown then slotDropdown:Select(tostring(s)) end end)
        
            removeToolByUID(uid, true)
        end
    end))

    return tool
end

local function clearToolsForSlot(slot)
    local changed = false
    for uid, entry in pairs(fakeToolsList) do
        if entry.slot == slot then
            fakeUIDs[uid] = nil
            fakeInventory[uid] = nil
            removeFakeEquipped(uid)
            pcall(function() entry.tool:Destroy() end)
            fakeToolsList[uid] = nil
            if fakeTools[slot] == entry then fakeTools[slot] = nil end
            changed = true
        end
    end
    if changed then refreshFakeInventory() end
end

local function removeLastToolForSlot(slot)
    local found
    for _, entry in pairs(fakeToolsList) do
        if entry.slot == slot and (not found or entry.uid > found.uid) then found = entry end
    end
    if not found then return false end
    fakeUIDs[found.uid] = nil
    fakeInventory[found.uid] = nil
    removeFakeEquipped(found.uid)
    pcall(function() found.tool:Destroy() end)
    fakeToolsList[found.uid] = nil
    if fakeTools[slot] == found then fakeTools[slot] = nil end
    refreshFakeInventory()
    return true
end

local function clearAllTools()
    local changed = false
    for uid, entry in pairs(fakeToolsList) do
        fakeUIDs[uid] = nil
        fakeInventory[uid] = nil
        removeFakeEquipped(uid)
        pcall(function() entry.tool:Destroy() end)
        fakeToolsList[uid] = nil
        changed = true
    end
    for k in pairs(fakeTools) do fakeTools[k] = nil end
    if changed then refreshFakeInventory() end
end

spawnRecord = function(slot, cat, itemData, pos, uid, existingRecord)
    if placed[slot] then
        local old = placed[slot]
        if old.uid then
            removeFakeEquipped(old.uid)
            fakeUIDs[old.uid] = nil
            fakeInventory[old.uid] = nil
        end
        if old.track then pcall(function() old.track:Stop() end) end
        if old.model then pcall(function() old.model:Destroy() end) end
    end

    local ok, model = pcall(function()
        return ItemDisplay.CreateWanderingAssetModel(LP.UserId, "FAKE_" .. spawnCounter, itemData, folder)
    end)
    if not ok or not model then
        notify({ Title = "Xitado Hub", Content = "No se pudo crear el rig: " .. tostring(model), Duration = 4 })
        return nil
    end
    spawnCounter += 1

    local kgLabel
    if settings.kg and settings.kg > 0 then
        kgLabel = tostring(math.floor(settings.kg)) .. "Kg"
    else
        local ok2, lbl = pcall(function() return AssetItems.WeightLabel(itemData) end)
        kgLabel = ok2 and lbl or "?"
    end

    local petUID = uid or ("FAKEPLOT_%d_%d_%d"):format(slot, os.time(), spawnCounter)
    local rec = {
        slot = slot,
        uid = petUID,
        cat = cat,
        label = Assets.Directory[cat] and (Assets.Directory[cat].DisplayName or cat) or cat,
        itemData = itemData,
        kgLabel = kgLabel,
        model = model,
        pos = pos,
        target = nil,
        wait = 0,
        phase = math.random() * math.pi * 2,
        speed = 0.12 + math.random() * 0.06,
        track = nil,
    }
    placed[slot] = rec

    fakeUIDs[petUID] = true
    fakeInventory[petUID] = existingRecord or inventoryRecord(rec, petUID)
    addFakeEquipped(petUID)
    refreshFakeInventory()

    pcall(function() model:PivotTo(CFrame.new(pos)) end)

    pcall(function()
        ItemDisplay.CreateDataBillboard(model, cat, itemData, rateFor(rec))
        tuneToolBillboard(model, rec.label)
    end)

    pickTarget(rec)

    pcall(function()
        local inner = model:FindFirstChild("Model")
        local ctrl = inner and inner:FindFirstChildWhichIsA("AnimationController")
        if ctrl then
            local animator = ctrl:FindFirstChildOfClass("Animator") or Instance.new("Animator", ctrl)
            local idle = Assets.Directory[cat].Animations and Assets.Directory[cat].Animations.Idle
            if idle then
                rec.track = animator:LoadAnimation(idle)
                rec.track.Looped = true
                rec.track:Play()
            end
        end
    end)

    return rec
end

local function consumeBagTool(cat)
    local chosen
    for uid, entry in pairs(fakeToolsList) do
        if (not cat or entry.cat == cat or (entry.tool and entry.tool:GetAttribute("Category") == cat))
            and (not chosen or uid > chosen) then
            chosen = uid
        end
    end
    if chosen then removeToolByUID(chosen) end
    return chosen ~= nil
end

local function placeSelected()
    local slot = nextFreeSlot()
    if not slot then
        notifyFull()
        return nil
    end
    local cat = selectedCat
    if not Assets.Directory[cat] then return end
    local rec = spawnRecord(slot, cat, itemDataFor(cat), slotPos(slot))
    if rec then
        settings.slot = slot
        settings.plotSlot = slot
        pcall(function() if slotDropdown then slotDropdown:Select(tostring(slot)) end end)
    
        consumeBagTool(cat)
        notify({
            Title = "Xitado Hub",
            Content = rec.label .. " -> slot " .. slot .. " | " .. compact(rateFor(rec)) .. "/s",
            Duration = 3,
        })
    end
    return rec
end

local function placeAllSlots()
    if not nextFreeSlot() then
        notifyFull()
        return
    end
    local cat = selectedCat
    if not Assets.Directory[cat] then return end
    local count = 0
    for slot = 1, 20 do
        if spawnRecord(slot, cat, itemDataFor(cat), slotPos(slot)) then count += 1 end
    end
    notify({
        Title = "Xitado Hub",
        Content = (Assets.Directory[cat].DisplayName or cat) .. " -> " .. count .. " slots.",
        Duration = 3,
    })
end

local function makeToolForSelected()
    local slot = math.clamp(settings.slot, 0, 20)
    local cat = selectedCat
    if not Assets.Directory[cat] then return end
    local data = itemDataFor(cat)
    local rec = {
        slot = slot,
        cat = cat,
        label = Assets.Directory[cat].DisplayName or cat,
        itemData = data,
    }
    local tool = ensureTool(rec)
    if tool then
        local count = 0
        for _ in pairs(fakeToolsList) do count += 1 end
        notify({ Title = "Xitado Hub", Content = rec.label .. " agregada a la mochila (" .. count .. ").", Duration = 3 })
    end
    return tool
end

local function removeBagToolSelected()
    local slot = math.clamp(settings.slot, 0, 20)
    if removeLastToolForSlot(slot) then
        notify({ Title = "Xitado Hub", Content = "Mascota quitada de la mochila.", Duration = 2 })
    else
        notify({ Title = "Xitado Hub", Content = "No hay mascotas en ese slot de la mochila.", Duration = 2 })
    end
end

local function removeAllBagTools()
    local count = 0
    for _ in pairs(fakeToolsList) do count += 1 end
    clearAllTools()
    notify({ Title = "Xitado Hub", Content = "Se quitaron " .. count .. " mascotas de la mochila.", Duration = 2 })
end

local function removeSlot(slot)
    local rec = placed[slot]
    if not rec then
        notify({ Title = "Xitado Hub", Content = "Slot " .. slot .. " vacio.", Duration = 2 })
        return
    end
    if rec.uid then
        removeFakeEquipped(rec.uid)
        fakeUIDs[rec.uid] = nil
        fakeInventory[rec.uid] = nil
    end
    if rec.track then pcall(function() rec.track:Stop() end) end
    if rec.model then pcall(function() rec.model:Destroy() end) end
    clearToolsForSlot(slot)
    placed[slot] = nil
    refreshFakeInventory()
    notify({ Title = "Xitado Hub", Content = "Slot " .. slot .. " limpio.", Duration = 2 })
end

local function clearAll()
    for slot, rec in pairs(placed) do
        if rec.uid then
            removeFakeEquipped(rec.uid)
            fakeUIDs[rec.uid] = nil
            fakeInventory[rec.uid] = nil
        end
        if rec.track then pcall(function() rec.track:Stop() end) end
        if rec.model then pcall(function() rec.model:Destroy() end) end
        placed[slot] = nil
    end
    clearAllTools()
    refreshFakeInventory()
    notify({ Title = "Xitado Hub", Content = "Todo limpiado.", Duration = 2 })
end

local function returnPlacedPetToBag(uid)
    local recData = recFromInventoryRecord(uid)
    if not recData then return false end
    local tool = ensureTool(recData, uid)
    return tool ~= nil
end

if AssetRoster and type(AssetRoster) == "table" and type(AssetRoster.WearAsset) == "function" then
    local original = getgenv().FakePetOriginalWearAsset or AssetRoster.WearAsset
    getgenv().FakePetOriginalWearAsset = original
    AssetRoster.WearAsset = function(uid)
        if fakeUIDs[uid] then return false, nil end
        return original(uid)
    end
end

if AssetRoster and type(AssetRoster) == "table" and type(AssetRoster.DoffAsset) == "function" then
    local original = getgenv().FakePetOriginalDoffAsset or AssetRoster.DoffAsset
    getgenv().FakePetOriginalDoffAsset = original
    AssetRoster.DoffAsset = function(uid)
        if fakeUIDs[uid] then
            if fakeEquipped[uid] then
                for slot, rec in pairs(placed) do
                    if rec.uid == uid then
                        if rec.track then pcall(function() rec.track:Stop() end) end
                        if rec.model then pcall(function() rec.model:Destroy() end) end
                        placed[slot] = nil
                        break
                    end
                end
                removeFakeEquipped(uid)
                pcall(function() returnPlacedPetToBag(uid) end)
                refreshFakeInventory()
            end
            return true, nil
        end
        return original(uid)
    end
end

