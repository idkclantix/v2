local function watchRealHUD()
    local moneyLabels, speedLabels = realHUDLabels()
    for _, lbl in ipairs(moneyLabels) do
        if not hudLabels[lbl] then
            hudLabels[lbl] = "money"
            track(lbl:GetPropertyChangedSignal("Text"):Connect(function()
                if updatingHUD or not settings.overrideHUD then return end
                updatingHUD = true
                pcall(function() lbl.Text = "$" .. compact(math.min(fakeMoney, MONEY_CAP)) end)
                updatingHUD = false
            end))
        end
    end
    for _, lbl in ipairs(speedLabels) do
        if not hudLabels[lbl] then
            hudLabels[lbl] = "speed"
            track(lbl:GetPropertyChangedSignal("Text"):Connect(function()
                if updatingHUD or not settings.fakeSpeed then return end
                updatingHUD = true
                pcall(function() lbl.Text = compact(math.min(fakeSpeed, SPEED_CAP)) end)
                updatingHUD = false
            end))
        end
    end
end
