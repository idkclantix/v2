    local d = {
        Category = cat,
        Mutations = muts,
        BaseMutation = tool:GetAttribute("BaseMutation") or muts[1],
        Scale = tonumber(tool:GetAttribute("Scale")) or scaleFor(cat),
        ColorSeed = tonumber(tool:GetAttribute("ColorSeed")) or 0,
