local function compact(n)
    n = math.max(0, tonumber(n) or 0)
    if Simple then
        local ok, s = pcall(function() return Simple.FormatCompact(math.floor(n), ".##") end)
        if ok and type(s) == "string" and s ~= "" then return s end
    end
    local suf = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc" }
    local i = 1
    while n >= 1000 and i < #suf do n /= 1000 i += 1 end
    if i == 1 then return tostring(math.floor(n)) end
    return ("%.2f%s"):format(n, suf[i])
end

local SUFFIX = {
    [""] = 1, K = 1e3, M = 1e6, B = 1e9, T = 1e12, QA = 1e15, QI = 1e18,
    SX = 1e21, SP = 1e24, OC = 1e27, NO = 1e30, DC = 1e33, UD = 1e36,
}
local function parseCompact(str)
    local s = tostring(str or ""):gsub("[,%$%s]", "")
    local num, suf = s:match("^(%d*%.?%d*)(%a*)$")
    if not num or num == "" then return nil end
    local mult = SUFFIX[tostring(suf):upper()]
    if not mult then return nil end
    local v = tonumber(num)
    return v and v * mult or nil
end

