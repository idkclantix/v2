local function resolvePlot()
    if PlotState then
        local ok, p = pcall(function() return PlotState.ResolvePlot() end)
        if ok and p and p.PlotFolder then return p end
    end
    return nil
end

local function plotCenter()
    local p = resolvePlot()
    if p and p.PlotFolder then
        local cp = p.PlotFolder:FindFirstChild("CenterPoint")
        if cp then return cp.Position end
    end
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local best, bestDist = nil, math.huge
    if root and workspace.Plots then
        for _, plot in ipairs(workspace.Plots:GetChildren()) do
            local sp = plot:FindFirstChild("SpawnPoint")
            if sp then
                local d = (sp.Position - root.Position).Magnitude
                if d < bestDist then best, bestDist = plot, d end
            end
        end
    end
    if best then
        local cp = best:FindFirstChild("CenterPoint")
        if cp then return cp.Position end
    end
    return root and root.Position or Vector3.new(0, 0, 0)
end

local function plotName()
    local p = resolvePlot()
    if p and p.PlotFolder then return tostring(p.PlotFolder.Name) end
    return "?"
end

local function nearPlot()
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    if AssetRoster and type(AssetRoster.FindPenArea) == "function" then
        local ok, pen = pcall(function() return AssetRoster.FindPenArea(LP) end)
        if ok and pen and pen:IsA("BasePart") then
            local localPos = pen.CFrame:PointToObjectSpace(root.Position)
            local half = pen.Size * 0.5
            local closest = pen.CFrame:PointToWorldSpace(Vector3.new(
                math.clamp(localPos.X, -half.X, half.X),
                math.clamp(localPos.Y, -half.Y, half.Y),
                math.clamp(localPos.Z, -half.Z, half.Z)
            ))
            return (root.Position - closest).Magnitude <= 20
        end
    end

    return (root.Position - plotCenter()).Magnitude <= 45
end

local function penBounds()
    if AssetRoster and type(AssetRoster.FindPenArea) == "function" then
        local ok, pen = pcall(function() return AssetRoster.FindPenArea(LP) end)
        if ok and pen and pen:IsA("BasePart") then
            local halfX = math.max(4, pen.Size.X * 0.5 - 2)
            local halfZ = math.max(4, pen.Size.Z * 0.5 - 2)
            return pen.CFrame, halfX, halfZ
        end
    end
    return CFrame.new(plotCenter()), 12, 8
end

local function groundY(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { folder }
    if LP.Character then filter[#filter + 1] = LP.Character end
    params.FilterDescendantsInstances = filter
    local hit = workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -300, 0), params)
    return hit and hit.Position.Y or (pos.Y - 3)
end

local function slotPos(slot)
    local cf, halfX, halfZ = penBounds()
    local col = (slot - 1) % 5
    local row = math.floor((slot - 1) / 5)
    local px = -halfX + (col + 0.5) * (2 * halfX / 5)
    local pz = -halfZ + (row + 0.5) * (2 * halfZ / 4)
    local p = cf:PointToWorldSpace(Vector3.new(px, 0, pz))
    return Vector3.new(p.X, groundY(Vector3.new(p.X, p.Y + 30, p.Z)) + 0.2, p.Z)
end 

local function patrolPose(slot, t)
    local cf, halfX, halfZ = penBounds()
    local margin = 2.5
    local ax = math.max(1, halfX - margin)
    local az = math.max(1, halfZ - margin)
    local seed = (slot - 1) * 1.37
    local x = math.sin(t + seed) * ax
    local z = math.sin(t * 0.73 + seed * 1.61 + 1.1) * az
    local p = cf:PointToWorldSpace(Vector3.new(x, 0, z))
    return Vector3.new(p.X, groundY(Vector3.new(p.X, p.Y + 30, p.Z)) + 0.2, p.Z)
end

